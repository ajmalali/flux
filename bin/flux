#!/usr/bin/env python3
"""flux — deterministic session machinery for Claude Code.

Single-file, stdlib-only, Python 3.9+. Rides in the plugin's bin/ so hooks can
call it as a bare command with zero install latency. Everything it injects into
model context has a hard byte budget it enforces itself (tokens ~= bytes / 4).

Commands: init | prime | state get/set/log/compact | task | check | handoff
          | run -- <cmd> | ledger | log <tag> "…" | guard | seal | claim add

  flux guard / flux seal          hook targets (UserPromptSubmit / SessionEnd),
                                  not called by hand: guard nudges a runaway
                                  session to wrap; seal flags an unwrapped one.

  flux init [--force] [--scan]   --scan: inventory prior project state, write nothing
  flux log <tag> "…"             append a field-log entry (tags: audit-hit|pack-miss|want)
  flux claim add <feat> <metric> <bar> [--scope repo|fleet|<name>] [--cycles N]
                                 register a falsifiable claim in .flux/claims.jsonl
  flux state log [N]             recent writes, newest first (default 20)
  flux state compact             collapse the log to one record per live key
  flux task add "<title>" [--files a,b] [--blocked-by t-x,t-y] [--verify "<cmd>"]
                         [--ref <path>] [--tier tracer|fill] [--tracer <id>]
                                 append a task, print its id (absent tier = tracer)
  flux task start <id> | done <id> --by "<what verified it>"
  flux task escalate <id> [--why "…"]     fill -> tracer, back to open; never lowers
  flux task await <id> --steps "…"        a person verifies; next surfaces it first
  flux task reopen <id> [--why "…"]       done or awaiting -> open
  flux task list [--open|--awaiting|--done|--all] | next [--all] | compact
                                 the execution index: which task is next, derived
                                 from an append-only log, not asserted
  flux run [--tail N] [--filter elide|failures|tail:N|raw] -- <command...>
  flux ledger [--since DATE] [--fleet] [--json] [--verdict]
                                 transcripts -> the read-out's targets table, per
                                 cycle, budgeted; --fleet: one row per adopting repo
                                 + meta-tax; --json: raw session rows, uncapped;
                                 --verdict: score each open claim (pending/moved/
                                 unmoved N) over the cycles that postdate it
"""

import base64
import calendar
import fnmatch
import hashlib
import json
import operator
import os
import re
import socket
import subprocess
import sys
import time

BYTES_PER_TOKEN = 4
DEFAULT_STATE_BUDGET_TOKENS = 2000
# The handoff carries more than the pack — a working-tree + commits snapshot — so it
# rides its own, larger cap (~1200 tokens, read-out item 4). Both `flux handoff` (the
# write) and prime's inline of the latest handoff clip to this, so the inlined copy can
# never overrun the pack: prime protects its footer separately (see _prime_inner).
DEFAULT_HANDOFF_BUDGET_TOKENS = 1200
COLD_SECONDS = 3600

# The field log — an append-only instrument (`flux log <tag> "…"`), created by init.
FIELD_LOG_NAME = "field-log.md"
# The prime pack's footer names the four session verbs so the model stops paying to
# rediscover them (read-out item 5). Its own cap, stricter than the pack budget.
PACK_FOOTER_BUDGET = 200
PACK_FOOTER = (
    'verbs — gate: flux check · subset: flux run -- <cmd> · '
    'close: flux check && flux state set … && flux handoff · '
    'log: flux log <tag> "…"'
)

# State is an append-only log, not a rewritten file. See read_state() for why.
STATE_LOG_NAME = "state.jsonl"
STATE_LOG_LEGACY = "state.toml"
# The task index rides the same append-only format; its section is further down.
TASKS_LOG_NAME = "tasks.jsonl"
# The log is stored state, so it is capped in code like everything else flux keeps:
# past this multiple of the rendered budget, `state set` compacts it.
STATE_LOG_BUDGET_MULTIPLE = 8
# Render order: the pack's keys first, then anything else alphabetically. Fixed so
# two clones replaying the same records produce byte-identical output.
STATE_KEY_ORDER = ("phase", "position", "next", "open")
# `updated` is derived from the newest surviving record. Storing it was one
# guaranteed-divergent line per session in a file every branch rewrote.
STATE_DERIVED_KEYS = ("updated",)
# Both logs are append-only and both are written by every session, so both need the
# union driver: git keeps each side's records and replay resolves the result.
GITATTRIBUTES_LINES = ("%s merge=union" % STATE_LOG_NAME,
                       "%s merge=union" % TASKS_LOG_NAME)
GITATTRIBUTES = (
    "# Concurrent appends from two branches must merge, not conflict: union keeps\n"
    "# both sides' records and `flux state get` / `flux task list` replay them.\n"
    + "".join("%s\n" % line for line in GITATTRIBUTES_LINES)
)

# ---------------------------------------------------------------- toml (subset)

def _parse_value(raw):
    raw = raw.strip()
    if raw.startswith('"') and raw.endswith('"'):
        return raw[1:-1].replace('\\"', '"').replace("\\\\", "\\")
    if raw.startswith("[") and raw.endswith("]"):
        inner = raw[1:-1].strip()
        if not inner:
            return []
        return [_parse_value(p) for p in re.findall(r'"(?:[^"\\]|\\.)*"|[^,]+', inner)]
    if raw in ("true", "false"):
        return raw == "true"
    try:
        return int(raw)
    except ValueError:
        return raw

def load_toml(path):
    """Read a TOML file. Uses tomllib when available; otherwise a parser for the
    flat subset flux itself emits (sections, strings, ints, bools, string arrays)."""
    try:
        import tomllib
        with open(path, "rb") as f:
            return tomllib.load(f)
    except ImportError:
        pass
    data = {}
    section = data
    with open(path, encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            if line.startswith("[") and line.endswith("]"):
                section = data.setdefault(line[1:-1].strip(), {})
                continue
            if "=" in line:
                key, _, raw = line.partition("=")
                raw = re.sub(r'\s+#(?![^"]*").*$', "", raw)  # trailing comment
                section[key.strip()] = _parse_value(raw)
    return data

def dump_flat_toml(mapping):
    """Serialize a flat str->str mapping. Still how the state pack is *rendered*
    for the byte budget — the budget prices context, not storage."""
    lines = []
    for key, value in mapping.items():
        escaped = str(value).replace("\\", "\\\\").replace('"', '\\"')
        lines.append('%s = "%s"' % (key, escaped))
    return "\n".join(lines) + "\n"

# ------------------------------------------------------------------- utilities

def repo_root():
    try:
        out = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            capture_output=True, text=True, timeout=10,
        )
        if out.returncode == 0:
            return out.stdout.strip()
    except Exception:
        pass
    return os.getcwd()

def flux_dir(root=None):
    return os.path.join(root or repo_root(), ".flux")

def git(args, cwd=None):
    try:
        out = subprocess.run(
            ["git"] + args, capture_output=True, text=True, timeout=15, cwd=cwd
        )
        return out.stdout.rstrip("\n") if out.returncode == 0 else ""
    except Exception:
        return ""

def read_config(root):
    path = os.path.join(flux_dir(root), "flux.toml")
    if not os.path.isfile(path):
        return None
    try:
        return load_toml(path)
    except Exception as exc:
        print("flux: could not parse .flux/flux.toml: %s" % exc, file=sys.stderr)
        return None

# ------------------------------------------------------------- state (the log)
#
# Why a log and not a file. `state.toml` was rewritten whole on every write, so
# every branch that held a session diverged on the same five lines. In a repo
# carrying ~100 branches (kiosk) that is a conflict on every merge, on a file
# nobody edits by hand -- which is why kiosk untracked it, and untracked state
# does not survive a clone. Appending one record per key instead means two
# branches that touched different keys merge cleanly, and `merge=union` (written
# to .flux/.gitattributes at init) makes git keep both sides' records even when
# they touched the same one. Replay resolves the result; git never has to.

def state_log_path(root):
    return os.path.join(flux_dir(root), STATE_LOG_NAME)

def read_log(path):
    """Records in file order. Anything unparseable is skipped, never raised.

    A union merge can leave a line git could not join, an interrupted write can
    leave a partial one -- and this is the file that carries the project between
    sessions. Rendering what is readable beats failing on what is not."""
    records = []
    try:
        with open(path, encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line.startswith("{"):
                    continue
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                if isinstance(rec, dict) and isinstance(rec.get("k"), str) and rec["k"]:
                    records.append(rec)
    except OSError:
        return []
    return records

def winners(records):
    """-> {key: (ts, value)}, last write per key, cleared keys included.

    Newest wins on (ts, file position). `ts` carries milliseconds, so a tie needs
    two branches writing the same key in the same millisecond; that falls back to
    file order, which is fixed within a clone and only ambiguous across one."""
    best = {}
    for i, rec in enumerate(records):
        key = rec["k"]
        stamp = (str(rec.get("ts", "")), i)
        if key not in best or stamp >= best[key][0]:
            best[key] = (stamp, str(rec.get("v", "")))
    return dict((k, (stamp[0], value)) for k, (stamp, value) in best.items())

def order_state(mapping):
    ordered = {}
    for key in STATE_KEY_ORDER:
        if key in mapping:
            ordered[key] = mapping[key]
    for key in sorted(mapping):
        if key not in ordered:
            ordered[key] = mapping[key]
    return ordered

def replay(records):
    """-> (ordered state, iso timestamp of the newest live record).

    An empty value clears a key -- the only way the TOML format ever had to
    remove one was to hand-edit the file."""
    live = dict((k, v) for k, (_ts, v) in winners(records).items() if v != "")
    stamps = [ts for _k, (ts, v) in winners(records).items() if v != ""]
    return order_state(live), max(stamps) if stamps else ""

def read_state(root):
    """The log is the source of truth; state.toml is read-only legacy."""
    log = state_log_path(root)
    if os.path.isfile(log):
        state, newest = replay(read_log(log))
        if newest:
            state["updated"] = local_stamp(newest)
        return state
    path = os.path.join(flux_dir(root), STATE_LOG_LEGACY)
    if not os.path.isfile(path):
        return {}
    try:
        return {k: v for k, v in load_toml(path).items() if not isinstance(v, dict)}
    except Exception:
        return {}

def append_records(path, pairs, stamp):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "a", encoding="utf-8") as f:
        for key, value in pairs:
            f.write(json.dumps({"ts": stamp, "k": key, "v": value},
                               ensure_ascii=False) + "\n")

def compact_log(path):
    """Rewrite as one record per live key, sorted, each keeping its own ts.

    Deterministic: two clones compacting the same records write identical bytes.
    Returns (records before, records after)."""
    records = read_log(path)
    live = sorted((k, ts, v) for k, (ts, v) in winners(records).items() if v != "")
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        for key, ts, value in live:
            f.write(json.dumps({"ts": ts, "k": key, "v": value},
                               ensure_ascii=False) + "\n")
    os.replace(tmp, path)
    return len(records), len(live)

def write_gitattributes(fdir):
    """Create it, or append only the lines it is missing. Repos adopted before the
    task index have a .gitattributes with the state line alone; rewriting the file
    would clobber whatever a human added beside it, so the missing line is appended
    instead -- with a leading newline when the file has no trailing one, or the two
    attributes fuse into a pattern git will never match."""
    path = os.path.join(fdir, ".gitattributes")
    if not os.path.exists(path):
        with open(path, "w", encoding="utf-8") as f:
            f.write(GITATTRIBUTES)
        return
    try:
        with open(path, encoding="utf-8") as f:
            body = f.read()
    except OSError:
        return
    missing = [line for line in GITATTRIBUTES_LINES if line not in body]
    if not missing:
        return
    try:
        with open(path, "a", encoding="utf-8") as f:
            if body and not body.endswith("\n"):
                f.write("\n")
            f.write("".join("%s\n" % line for line in missing))
    except OSError:
        return

def state_budget_bytes(cfg):
    budget = DEFAULT_STATE_BUDGET_TOKENS
    if cfg and isinstance(cfg.get("state"), dict):
        budget = cfg["state"].get("budget_tokens", budget)
    return int(budget) * BYTES_PER_TOKEN

def handoff_budget_bytes(cfg):
    budget = DEFAULT_HANDOFF_BUDGET_TOKENS
    if cfg and isinstance(cfg.get("state"), dict):
        budget = cfg["state"].get("handoff_budget_tokens", budget)
    return int(budget) * BYTES_PER_TOKEN

def clip(text, max_bytes, marker="\n[flux: truncated at budget]"):
    data = text.encode("utf-8")
    if len(data) <= max_bytes:
        return text
    keep = data[: max(0, max_bytes - len(marker.encode("utf-8")))]
    return keep.decode("utf-8", errors="ignore") + marker

def now_stamp():
    return time.strftime("%Y-%m-%d %H:%M", time.localtime())

def now_iso():
    """UTC, milliseconds. Records are ordered across machines, so the stamp has
    to be absolute; milliseconds so two writes in one session cannot tie."""
    t = time.time()
    return time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime(t)) + ".%03dZ" % (t % 1 * 1000)

def local_stamp(iso):
    """A log timestamp rendered the way state.toml's `updated` always looked."""
    try:
        epoch = calendar.timegm(time.strptime(iso.split(".")[0].rstrip("Z"),
                                              "%Y-%m-%dT%H:%M:%S"))
        return time.strftime("%Y-%m-%d %H:%M", time.localtime(epoch))
    except Exception:
        return iso

def _iso_epoch(iso):
    """ISO stamp (as now_iso() writes) -> UTC epoch seconds, or None if unparseable."""
    try:
        base = str(iso).split(".")[0].rstrip("Z")
        return calendar.timegm(time.strptime(base, "%Y-%m-%dT%H:%M:%S"))
    except Exception:
        return None

def _key_age_days(iso):
    """Whole days between an ISO write stamp and now (UTC), or None if unparseable."""
    epoch = _iso_epoch(iso)
    if epoch is None:
        return None
    return int((time.time() - epoch) // 86400)

# ------------------------------------------------------- hooks + cache scratch
#
# guard (UserPromptSubmit) and seal (SessionEnd) are hook targets, so they carry
# prime's discipline: read one JSON object off stdin, no-op silently on anything
# unexpected, never return non-zero. Their memory lives in .flux/cache/ — the
# same gitignored scratch dir _cold_gap_seconds keeps last-prime in.

def _hook_input():
    """The hook's JSON object off stdin. {} on empty / unparseable / non-object."""
    try:
        obj = json.loads(sys.stdin.read())
        return obj if isinstance(obj, dict) else {}
    except Exception:
        return {}

def _cache_dir(root):
    return os.path.join(flux_dir(root), "cache")

def _read_cache_json(root, name):
    try:
        with open(os.path.join(_cache_dir(root), name), encoding="utf-8") as f:
            obj = json.load(f)
        return obj if isinstance(obj, dict) else {}
    except Exception:
        return {}

def _write_cache_json(root, name, obj):
    try:
        cdir = _cache_dir(root)
        os.makedirs(cdir, exist_ok=True)
        with open(os.path.join(cdir, name), "w", encoding="utf-8") as f:
            json.dump(obj, f)
    except Exception:
        pass

def _guard_cfg(cfg, key, default):
    """A [guard] key as int, else the code default — every adopted repo works
    unedited (missing table or key falls back)."""
    table = cfg.get("guard") if cfg else None
    if isinstance(table, dict) and key in table:
        try:
            return int(table[key])
        except (TypeError, ValueError):
            return default
    return default

def _touch_wrap(root):
    """The breadcrumb every real wrap leaves — O(1). seal reads it (transcript-free)
    to tell a wrapped session from an unwrapped one. Errors swallowed: a missed
    touch costs one seal warning, never state."""
    try:
        cdir = _cache_dir(root)
        os.makedirs(cdir, exist_ok=True)
        with open(os.path.join(cdir, "last-wrap"), "w", encoding="utf-8") as f:
            f.write(now_iso())
    except Exception:
        pass

# ------------------------------------------------------------------------ init

# Detection proposes a *candidate* gate; a human confirms it at adoption and the
# first full pass stamps it verified. Two rules bind every entry below:
#   1. the command must run the WHOLE gate. Never a diff-scoped subset
#      (`nx affected`, `jest -o`, `cargo test -p one`) — a gate whose meaning
#      moves with the diff is not a gate. Scoped runs are `flux run --`.
#   2. if a marker can't yield a runnable command, return None so the next rule
#      gets a turn. Proposing a command that cannot work is worse than silence.

JS_SCRIPT_PREFERENCE = ("check", "ci", "verify", "test:ci", "test")
JS_LOCKFILES = (("pnpm-lock.yaml", "pnpm"), ("yarn.lock", "yarn"),
                ("bun.lockb", "bun"), ("bun.lock", "bun"))
MAKE_TARGETS = ("check", "ci", "verify", "test")


def _read_json(path):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def _first_marker(root, markers):
    """First marker present in root. Patterns containing '*' glob the tree top."""
    entries = None
    for pattern in markers:
        if "*" in pattern:
            if entries is None:
                try:
                    entries = sorted(os.listdir(root))
                except OSError:
                    entries = []
            hits = fnmatch.filter(entries, pattern)
            if hits:
                return hits[0]
        elif os.path.exists(os.path.join(root, pattern)):
            return pattern
    return None


def _read_text(root, name):
    try:
        with open(os.path.join(root, name), encoding="utf-8", errors="ignore") as f:
            return f.read()
    except OSError:
        return ""


def _js_command(root, _marker):
    pkg = _read_json(os.path.join(root, "package.json"))
    if pkg is None:
        return None
    scripts = pkg.get("scripts") or {}
    manager = "npm"
    for lockfile, name in JS_LOCKFILES:
        if os.path.exists(os.path.join(root, lockfile)):
            manager = name
            break
    for script in JS_SCRIPT_PREFERENCE:
        if script in scripts:
            if script == "test" and "lint" in scripts:
                return "%s run lint && %s run test" % (manager, manager)
            return "%s run %s" % (manager, script)
    return None                      # a package.json without a test script is not a gate


def _dart_command(root, marker):
    if "\nflutter:" in _read_text(root, marker):
        return "flutter analyze && flutter test"
    return "dart analyze && dart test"


def _unittest_command(root, marker):
    """A Python repo with tests but no packaging metadata — flux's own shape."""
    try:
        names = os.listdir(os.path.join(root, marker))
    except OSError:
        return None
    if any(n.startswith("test_") and n.endswith(".py") for n in names) or \
       any(n.endswith("_test.py") for n in names):
        return "python3 -m unittest discover -s %s" % marker
    return None


def _ruby_command(root, _marker):
    if os.path.exists(os.path.join(root, "Rakefile")):
        return "bundle exec rake"
    if os.path.isdir(os.path.join(root, "spec")):
        return "bundle exec rspec"
    return None


def _php_command(root, _marker):
    pkg = _read_json(os.path.join(root, "composer.json"))
    scripts = (pkg or {}).get("scripts") or {}
    for script in ("check", "ci", "test"):
        if script in scripts:
            return "composer run-script %s" % script
    return None


def _make_command(root, marker):
    """`make test` is a gate only if the file actually declares that target."""
    runner = "just" if marker.lower() == "justfile" else "make"
    text = _read_text(root, marker)
    for target in MAKE_TARGETS:
        if re.search(r"^%s\s*:" % re.escape(target), text, re.M):
            return "%s %s" % (runner, target)
    return None


def _static(command):
    return lambda root, marker: command


# Ordered most specific first: a monorepo runner beats the package manager it
# wraps, a wrapper script beats the bare tool, a lockfile beats its manifest.
CHECK_RULES = [
    (("nx.json",), _static("npx nx run-many -t lint,typecheck,test")),
    (("turbo.json",), _static("npx turbo run lint typecheck test")),
    (("MODULE.bazel", "WORKSPACE.bazel", "WORKSPACE"), _static("bazel test //...")),
    (("Cargo.toml",), _static("cargo clippy --quiet && cargo test --quiet")),
    (("go.mod",), _static("go vet ./... && go test ./...")),
    (("mix.exs",), _static("mix test")),
    (("Package.swift",), _static("swift test")),
    (("deno.json", "deno.jsonc"), _static("deno lint && deno test -A")),
    (("pubspec.yaml",), _dart_command),
    (("gradlew",), _static("./gradlew check")),
    (("build.gradle", "build.gradle.kts", "settings.gradle"), _static("gradle check")),
    (("mvnw",), _static("./mvnw -q verify")),
    (("pom.xml",), _static("mvn -q verify")),
    (("*.sln", "*.slnx", "*.csproj", "*.fsproj"), _static("dotnet test")),
    (("uv.lock",), _static("uv run ruff check . && uv run pytest -q")),
    (("poetry.lock",), _static("poetry run pytest -q")),
    (("pyproject.toml", "tox.ini", "setup.cfg"), _static("python3 -m pytest -q")),
    (("tests", "test"), _unittest_command),
    (("Gemfile",), _ruby_command),
    (("composer.json",), _php_command),
    (("package.json",), _js_command),
    (("justfile", "Justfile", "Makefile", "makefile"), _make_command),
]


def detect_check_command(root):
    for markers, build in CHECK_RULES:
        marker = _first_marker(root, markers)
        if marker is None:
            continue
        command = build(root, marker)
        if command:
            return marker, command
    return None, ""


# ------------------------------------------------- prior project state (adopt)

# Repos arrive carrying knowledge already: a framework's state directory, a
# hand-kept roadmap, or just a CLAUDE.md. flux finds and sizes those sources so
# `/flux:adopt` can migrate the live parts. It never parses any of them — teaching
# the CLI a framework's file format would make the plugin a per-project fork, and
# deciding what in a 299 KB state file is still true is judgment, not procedure.
# Adding a framework here is one line; adding a parser is not allowed.
STATE_SOURCE_RULES = [
    ("paul", (".paul", ".claude/paul-framework"), "PAUL project state / framework"),
    ("agent-os", (".agent-os",), "Agent OS state"),
    ("taskmaster", (".taskmaster", "tasks/tasks.json"), "Task Master tasks"),
    ("openspec", (".openspec", "openspec"), "OpenSpec specs"),
    ("kiro", (".kiro",), "Kiro specs / steering"),
    ("specstory", (".specstory",), "SpecStory history"),
    ("cursor", (".cursorrules", ".cursor/rules"), "Cursor rules"),
    ("windsurf", (".windsurfrules", ".windsurf"), "Windsurf rules"),
    ("copilot", (".github/copilot-instructions.md",), "Copilot instructions"),
    ("claude-md", ("CLAUDE.md", ".claude/CLAUDE.md"), "Claude project instructions"),
    ("agents-md", ("AGENTS.md",), "agent instructions"),
    ("roadmap", ("ROADMAP.md", "docs/ROADMAP.md"), "hand-kept roadmap"),
    ("status", ("STATE.md", "STATUS.md", "PROGRESS.md"), "hand-kept status"),
    ("todo", ("TODO.md", "TASKS.md"), "hand-kept task list"),
    ("decisions", ("DECISIONS.md", "docs/adr", "docs/decisions"), "decision records"),
]

SCAN_SKIP_DIRS = (".git", "node_modules", "__pycache__", ".venv", "venv", "dist", "build")
SCAN_WALK_LIMIT = 2000       # files inspected per source before we stop counting
SCAN_MAX_SOURCES = 20        # inventory lines; the rest are summarised as a count
SCAN_TOP_FILES = 3           # biggest files named per directory source
PROSE_SUFFIXES = (".md", ".mdx", ".txt", ".rst", ".org", ".json", ".toml", ".yaml", ".yml")


def _dir_stats(path):
    """(total bytes, file count, [(size, path)...]) for a directory source."""
    total, count, files = 0, 0, []
    for dirpath, dirnames, filenames in os.walk(path):
        dirnames[:] = [d for d in dirnames if d not in SCAN_SKIP_DIRS]
        for name in filenames:
            full = os.path.join(dirpath, name)
            try:
                size = os.path.getsize(full)
            except OSError:
                continue
            total += size
            count += 1
            files.append((size, full))
            if count >= SCAN_WALK_LIMIT:
                return total, count, files
    return total, count, files


def detect_state_sources(root):
    """Every prior-state marker present, largest first. Reads no file's contents."""
    found = []
    for label, markers, note in STATE_SOURCE_RULES:
        for marker in markers:
            path = os.path.join(root, marker)
            if not os.path.exists(path):
                continue
            if os.path.isdir(path):
                total, count, files = _dir_stats(path)
                if not count:
                    continue
                # Point the skill at the prose, not the assets: a 3 MB mockup is the
                # biggest file in .paul/ but carries none of the project's knowledge.
                prose = [f for f in files if f[1].lower().endswith(PROSE_SUFFIXES)]
                top = [os.path.relpath(p, path) for _, p in
                       sorted(prose or files, key=lambda f: -f[0])[:SCAN_TOP_FILES]]
            else:
                try:
                    total = os.path.getsize(path)
                except OSError:
                    continue
                if not total:
                    continue
                count, top = 1, []
            found.append({"label": label, "path": marker, "bytes": total,
                          "files": count, "top": top, "note": note})
    found.sort(key=lambda s: -s["bytes"])
    return found


def human_bytes(n):
    if n >= 1024 * 1024:
        return "%.1f MB" % (n / (1024.0 * 1024.0))
    if n >= 1024:
        return "%d KB" % (n // 1024)
    return "%d B" % n


def format_state_sources(sources):
    lines = []
    for source in sources[:SCAN_MAX_SOURCES]:
        size = human_bytes(source["bytes"])
        detail = "%s, %d files" % (size, source["files"]) if source["files"] > 1 else size
        line = "  %-11s %-26s %s" % (source["label"], source["path"], detail)
        if source["top"]:
            line += "   biggest: %s" % ", ".join(source["top"])
        lines.append(line)
    if len(sources) > SCAN_MAX_SOURCES:
        lines.append("  ... +%d more" % (len(sources) - SCAN_MAX_SOURCES))
    return lines


def _scan_budget(root):
    cfg = read_config(root)
    return state_budget_bytes(cfg) if cfg else DEFAULT_STATE_BUDGET_TOKENS * BYTES_PER_TOKEN


def cmd_init_scan(root):
    """`flux init --scan` — inventory only. Writes nothing, reads no contents."""
    sources = detect_state_sources(root)
    name = os.path.basename(root)
    if not sources:
        print("flux init --scan: no prior project state found in %s" % name)
        return 0
    lines = ["flux init --scan: prior project state in %s" % name]
    lines.extend(format_state_sources(sources))
    lines.append("nothing read, nothing written. `/flux:adopt` migrates the live parts "
                 "into .flux/ and can retire the rest.")
    print(clip("\n".join(lines), _scan_budget(root)))
    return 0


FLUX_TOML_TEMPLATE = """\
# .flux/flux.toml — the whole per-repo adapter. Written by `flux init`.

[check]
command = "%(check)s"
filter  = "failures"          # failures | tail:80 | raw
verified = false              # flips to true on the first full `flux check` pass

[state]
budget_tokens = 2000          # flux refuses to emit or store more than this

[guard]                       # session-boundary hooks (guard/seal). All optional —
# warn_requests = 120         #   guard nudges to wrap past this request count
# renudge       = 25          #   ...then stays quiet until this many more
# stale_days    = 2           #   prime tags a state key ` [Nd]` older than this
# substantive_seconds = 180   #   seal calls a session real (worth a wrap) past this
# cycle_refresh_hours = 6      #   flux repo: prime recomputes the fleet cycle count past this

[task]                        # the execution index (`flux task`). All optional —
# lease_hours = 12            #   how long one worktree's claim on a task holds

[run]
tail = 100                    # `flux run` keeps at most this many trailing lines
filter = "elide"              # elide | failures | tail:80 | raw (--filter overrides)
"""

def cmd_init(args):
    root = repo_root()
    if "--scan" in args:
        return cmd_init_scan(root)
    fdir = flux_dir(root)
    toml_path = os.path.join(fdir, "flux.toml")
    if os.path.exists(toml_path) and "--force" not in args:
        print("flux init: .flux/flux.toml already exists (use --force to overwrite)")
        return 1
    os.makedirs(fdir, exist_ok=True)
    detected, check = detect_check_command(root)
    with open(toml_path, "w", encoding="utf-8") as f:
        f.write(FLUX_TOML_TEMPLATE % {"check": check.replace('"', '\\"')})
    state_path = os.path.join(fdir, STATE_LOG_NAME)
    if not os.path.exists(state_path) and not os.path.exists(
            os.path.join(fdir, STATE_LOG_LEGACY)):
        open(state_path, "a", encoding="utf-8").close()  # empty log, keys unset
    field_path = os.path.join(fdir, FIELD_LOG_NAME)
    if not os.path.exists(field_path):  # created empty; never clobbers accrued entries
        open(field_path, "a", encoding="utf-8").close()
    write_gitattributes(fdir)
    gitignore_path = os.path.join(fdir, ".gitignore")
    if not os.path.exists(gitignore_path):
        with open(gitignore_path, "w", encoding="utf-8") as f:
            f.write("# flux runtime scratch — rebuildable, never committed\ncache/\n")
    if detected:
        print("flux init: wrote .flux/flux.toml (detected %s -> check candidate: %s)" % (detected, check))
        print("run `flux check` once to validate it; edit [check].command in .flux/flux.toml if wrong")
    else:
        print("flux init: wrote .flux/flux.toml — no gate detected. Set [check].command "
              "to whatever verifies this repo (any shell command), then run `flux check` "
              "once to validate it")
    _report_prior_state(root)
    return 0


def _report_prior_state(root):
    """Name what this repo already knows, and print the adoption recipe inline so a
    session need not open /flux:adopt to know the next steps. init itself stays
    deterministic: it does not open a single one of these files. The recipe is capped
    like every other output flux emits (clip to the scan budget)."""
    sources = detect_state_sources(root)
    if not sources:
        return
    named = ", ".join("%s (%s)" % (s["path"], human_bytes(s["bytes"]))
                      for s in sources[:3])
    extra = " +%d more" % (len(sources) - 3) if len(sources) > 3 else ""
    lines = [
        "flux init: this repo already carries project state — %s%s" % (named, extra),
        "",
        "adopt recipe (short form; /flux:adopt is the full reference, "
        "`flux init --scan` lists all of it):",
        "  1. flux init --scan  — inventory prior state; opens nothing.",
        "  2. sort it: live (where the work stands, next, what's blocked/unproven) vs "
        "history (everything else — leave it exactly where it is). Read big state "
        "files from the ends with cut -c1-300, never whole.",
        "  3. flux state set phase \"..\" position \"..\" next \"..\" open \"..\"  — the "
        "live pack, five values; check it against git log / branch / dirty tree — the "
        "tree wins over a stale document.",
        "  4. flux prime  — read it back as a stranger; fix what a cold session "
        "couldn't act on.",
        "  5. flux check  — validate the detected gate and flip its verified stamp.",
        "  Retiring the old framework is opt-in and archives (never deletes) — /flux:adopt.",
    ]
    print(clip("\n".join(lines), _scan_budget(root)))

# ----------------------------------------------------------------------- prime

def cmd_prime(_args):
    """SessionStart hook target. Must be fast and must never fail or nag in
    repos that don't use flux — hence the blanket except and silent no-op."""
    try:
        return _prime_inner()
    except Exception:
        return 0

def _prime_inner():
    root = repo_root()
    cfg = read_config(root)
    if cfg is None:
        return 0  # not a flux repo — silent no-op
    state = read_state(root)
    budget = state_budget_bytes(cfg)

    lines = []
    branch = git(["branch", "--show-current"], cwd=root) or "(detached)"
    dirty = git(["status", "--porcelain"], cwd=root)
    n_dirty = len(dirty.splitlines())
    dirty_note = ", %d dirty file%s" % (n_dirty, "" if n_dirty == 1 else "s") if dirty else ", clean"
    drift = _ahead_behind(root, branch)
    drift_note = ", %s" % drift if drift else ""
    lines.append(
        "## flux prime — %s @ %s%s%s"
        % (os.path.basename(root), branch, drift_note, dirty_note)
    )

    cold = _cold_gap_seconds(root)
    if cold is not None and cold > COLD_SECONDS:
        lines.append(
            "note: %.1fh since last session — the prompt cache is cold; start from this pack, don't revive old context."
            % (cold / 3600.0)
        )

    aged = winners(read_log(state_log_path(root)))  # {key: (ts, value)}, newest write
    stale_days = _guard_cfg(cfg, "stale_days", 2)
    # The index, when there is one, owns the `phase` slot and can fill the `next` one.
    # Both derived lines are emitted here, inside the key loop, so pack order never
    # depends on which path produced them. With no index both are "" and every line
    # below is byte-for-byte what it was before the index existed.
    task_line, task_next, task_await = _task_pack_lines_safe(root, cfg)
    for key in ("phase", "position", "next", "open"):
        if key == "phase" and task_line:
            lines.append(task_line)  # replaces `phase:`, never rides beside it
            if task_await:
                lines.append(task_await)  # the steps a person is on, clipped
            continue
        value = str(state.get(key, "")).strip()
        if not value:
            if key == "next" and task_next:
                lines.append(task_next)  # no [Nd] suffix: it is derived, not stored
            continue
        line = "%s: %s" % (key, value)
        info = aged.get(key)
        if info:
            age = _key_age_days(info[0])
            if age is not None and age > stale_days:
                line += " [%dd]" % age  # a key riding the pack past its shelf life
        lines.append(line)
    last_session = _read_cache_json(root, "last-session.json")
    if last_session.get("warn"):
        lines.append("warn: last session ended unwrapped — its next/open may be "
                     "stale; verify before trusting the pack.")
    check_cfg = cfg.get("check") or {}
    check = check_cfg.get("command", "")
    if check:
        unverified = "  [unverified — run it once]" if check_cfg.get("verified") is False else ""
        lines.append("check: flux check  (%s)%s" % (check, unverified))
    latest = _latest_handoff(root)
    if latest:
        try:
            with open(latest, encoding="utf-8") as f:
                body = f.read().strip()
            if body:
                body = clip(body, handoff_budget_bytes(cfg))
                lines.append("last handoff (%s), inlined:" % os.path.basename(latest))
                lines.append(body)
            else:
                lines.append("last handoff: %s" % os.path.relpath(latest, root))
        except Exception:
            lines.append("last handoff: %s" % os.path.relpath(latest, root))
    if not state.get("next") and not task_next:
        lines.append("next: (unset — `flux state set next \"...\"` at wrap)")

    _append_cycle_line(root, cfg, lines)  # flux-repo-only; owns its try/except (A2)

    # Clip the body first, then append the footer — never the reverse. The inlined
    # handoff can be large, so clipping the whole string after the footer would eat the
    # verbs; instead reserve the footer's bytes (+1 for the join newline) up front. If
    # the budget is smaller than the footer itself (only an absurdly tight config), the
    # budget still wins — it is the binding invariant — so fall back to a whole-string
    # clip that may truncate the footer rather than overrun the cap.
    reserve = len(PACK_FOOTER.encode("utf-8")) + 1
    if budget > reserve:
        body = clip("\n".join(lines), budget - reserve)
        print(body + "\n" + PACK_FOOTER)  # the verbs, so a cold session need not rediscover them
    else:
        lines.append(PACK_FOOTER)
        print(clip("\n".join(lines), budget))
    return 0

def _ahead_behind(root, branch):
    """Divergence, derived live — two independent legs.

    The upstream answers "have I pushed?"; the default branch answers "how far has
    this branch come?". A feature branch in sync with its own remote must still
    report the second, or the header goes silent exactly when the branch is most
    interesting. Anything git can answer must not be stored in `position` — stored
    prose about the tree invalidates itself on the very next commit."""
    legs = []
    upstream = git(
        ["rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{upstream}"], cwd=root
    )
    if upstream:
        counts = _rev_list_counts(root, upstream)
        if counts:
            behind, ahead = counts
            if ahead and behind:
                legs.append("%d unpushed, %d behind %s" % (ahead, behind, upstream))
            elif ahead:
                legs.append("%d unpushed" % ahead)
            elif behind:
                legs.append("%d behind %s" % (behind, upstream))
    base = _default_base(root, branch)
    if base and base != upstream:
        counts = _rev_list_counts(root, base)
        if counts:
            behind, ahead = counts
            if ahead and behind:
                legs.append("%d ahead, %d behind %s" % (ahead, behind, base))
            elif ahead:
                legs.append("%d ahead of %s" % (ahead, base))
            elif behind:
                legs.append("%d behind %s" % (behind, base))
    return ", ".join(legs) if legs else None

def _rev_list_counts(root, base):
    """(behind, ahead) relative to base, or None if git can't answer."""
    parts = git(
        ["rev-list", "--left-right", "--count", "%s...HEAD" % base], cwd=root
    ).split()
    if len(parts) != 2:
        return None
    try:
        return int(parts[0]), int(parts[1])
    except ValueError:
        return None

def _default_base(root, branch):
    """The repo's default branch, never the branch we're standing on."""
    for candidate in ("origin/HEAD", "origin/main", "origin/master", "main", "master"):
        if candidate in (branch, "origin/" + branch):
            continue
        if candidate == "origin/HEAD":
            resolved = git(["rev-parse", "--abbrev-ref", "origin/HEAD"], cwd=root)
            if resolved and resolved.split("/")[-1] != branch:
                return resolved
            continue
        if git(["rev-parse", "--verify", "--quiet", candidate + "^{commit}"], cwd=root):
            return candidate
    return None

def _cold_gap_seconds(root):
    marker = os.path.join(flux_dir(root), "cache", "last-prime")
    gap = None
    try:
        if os.path.exists(marker):
            gap = time.time() - os.path.getmtime(marker)
        os.makedirs(os.path.dirname(marker), exist_ok=True)
        with open(marker, "w") as f:
            f.write(str(int(time.time())))
    except Exception:
        pass
    return gap

def _latest_handoff(root):
    hdir = os.path.join(flux_dir(root), "handoffs")
    if not os.path.isdir(hdir):
        return None
    entries = sorted(e for e in os.listdir(hdir) if e.endswith(".md"))
    return os.path.join(hdir, entries[-1]) if entries else None

# ------------------------------------------------------------------------ guard

def _hook_transcript(data, root):
    """This session's transcript, best-effort: prefer stdin's transcript_path, else
    the reliable on-disk name PROJECTS_DIR/<slug>/<session_id>.jsonl. None if
    neither resolves to a file — the caller no-ops."""
    tp = data.get("transcript_path")
    if tp and os.path.isfile(tp):
        return tp
    sid = data.get("session_id")
    if sid:
        cand = os.path.join(PROJECTS_DIR, _slug_for_path(root), str(sid) + ".jsonl")
        if os.path.isfile(cand):
            return cand
    return None

def cmd_guard(_args):
    """UserPromptSubmit hook target. Counts this session's main-thread requests the
    way the ledger does and, past the threshold, injects one nudge to wrap+clear.
    A nudge, never a gate: it never returns non-zero (exit 2 would block the
    prompt) and no-ops silently in non-flux repos / on any failure."""
    try:
        return _guard_inner()
    except Exception:
        return 0

def _guard_inner():
    data = _hook_input()
    root = repo_root()
    cfg = read_config(root)
    if cfg is None:
        return 0  # not a flux repo — silent
    path = _hook_transcript(data, root)
    if not path:
        return 0  # no resolvable transcript — silent (transcript_path is best-effort)
    row = _scan_session(path)
    count = row["requests"] if row else 0
    warn_at = _guard_cfg(cfg, "warn_requests", 120)
    renudge = _guard_cfg(cfg, "renudge", 25)
    if count < warn_at:
        return 0
    sid = str(data.get("session_id", ""))
    memo = _read_cache_json(root, "guard.json")
    last = int(memo.get("last_warn", 0)) if memo.get("session_id") == sid else 0
    if last and count < last + renudge:
        return 0  # already warned this session; inside the re-nudge window
    print("flux guard: this session is at %d requests (past the smart zone). "
          "Wrap now — flux check && flux state set … && flux handoff — then /clear."
          % count)
    _write_cache_json(root, "guard.json", {"session_id": sid, "last_warn": count})
    return 0

# ------------------------------------------------------------------------- seal

def cmd_seal(_args):
    """SessionEnd hook target. O(1) and transcript-free — SessionEnd's teardown
    budget is tight and its stdout is ignored. Decides wrapped/substantive from
    cheap .flux/cache/ breadcrumbs, logs an unwrapped substantive session, and
    leaves a marker prime warns on next start. Never returns non-zero."""
    try:
        return _seal_inner()
    except Exception:
        return 0

def _seal_inner():
    data = _hook_input()
    root = repo_root()
    cfg = read_config(root)
    if cfg is None:
        return 0  # not a flux repo — silent
    try:
        # Before the early return below: a session with no last-prime marker still
        # holds leases, and a lease nobody clears parks the task for lease_hours.
        _clear_own_leases(root)
    except Exception:
        pass
    reason = str(data.get("reason", "other")) or "other"
    sub_secs = _guard_cfg(cfg, "substantive_seconds", 180)
    try:
        prime_at = os.path.getmtime(os.path.join(_cache_dir(root), "last-prime"))
    except OSError:
        # No SessionStart marker — nothing to measure this session against.
        _write_cache_json(root, "last-session.json",
                          {"warn": False, "wrapped": False, "reason": reason,
                           "ts": now_iso()})
        return 0
    wrap_at = _iso_epoch(_read_last_wrap(root))
    now = time.time()
    wrapped = wrap_at is not None and wrap_at >= prime_at
    substantive = (now - prime_at) >= sub_secs
    warn = substantive and not wrapped
    _write_cache_json(root, "last-session.json",
                      {"warn": warn, "wrapped": wrapped, "reason": reason,
                       "ts": now_iso()})
    if warn:
        minutes = int((now - prime_at) / 60)
        _append_field_log(root, "unwrapped",
                          "reason=%s, ~%dm session, no state write" % (reason, minutes))
    return 0

def _read_last_wrap(root):
    try:
        with open(os.path.join(_cache_dir(root), "last-wrap"), encoding="utf-8") as f:
            return f.read().strip()
    except OSError:
        return ""

# ----------------------------------------------------------------------- state

def cmd_state(args):
    root = repo_root()
    cfg = read_config(root)
    if cfg is None:
        print("flux state: no .flux/flux.toml here — run `flux init` first", file=sys.stderr)
        return 1
    state = read_state(root)
    if not args or args[0] == "get":
        keys = args[1:] if args else []
        if keys:
            for key in keys:
                print(state.get(key, ""))
        else:
            for key, value in state.items():
                print("%s = %s" % (key, value))
        return 0
    if args[0] == "set":
        pairs = args[1:]
        if not pairs or len(pairs) % 2 != 0:
            print("usage: flux state set <key> <value> [<key> <value>...]", file=sys.stderr)
            return 2
        bad = [pairs[i] for i in range(0, len(pairs), 2) if pairs[i].startswith("-")]
        if bad:
            # `state set` takes bare key/value pairs, so a leading dash is always a
            # mistyped flag. Accepting it writes a key named "--phase" beside the real
            # one, the write reports success, and prime keeps rendering the stale
            # value -- silent corruption of the one file that carries a project
            # across sessions. Refuse instead.
            print("flux state: %s looks like a flag, not a key. Usage: "
                  "flux state set <key> <value> [<key> <value>...]"
                  % ", ".join(bad), file=sys.stderr)
            return 2
        derived = [pairs[i] for i in range(0, len(pairs), 2)
                   if pairs[i] in STATE_DERIVED_KEYS]
        if derived:
            print("flux state: %s is derived from the log, not stored — "
                  "nothing to set" % ", ".join(derived), file=sys.stderr)
            return 2
        migrate_legacy(root)
        writes = [(pairs[i], pairs[i + 1]) for i in range(0, len(pairs), 2)]
        for key, value in writes:
            state[key] = value
        state = order_state(dict((k, v) for k, v in state.items()
                                 if k not in STATE_DERIVED_KEYS and str(v) != ""))
        state["updated"] = now_stamp()
        serialized = dump_flat_toml(state)
        budget = state_budget_bytes(cfg)
        if len(serialized.encode("utf-8")) > budget:
            # Checked before appending, so an over-budget write leaves the log
            # exactly as it was -- same guarantee the rewritten file gave.
            print(
                "flux state: refused — write would be %d bytes, budget is %d "
                "([state].budget_tokens x %d). Trim values; move prose to a plan doc."
                % (len(serialized.encode("utf-8")), budget, BYTES_PER_TOKEN),
                file=sys.stderr,
            )
            return 1
        path = state_log_path(root)
        append_records(path, writes, now_iso())
        write_gitattributes(flux_dir(root))
        print(
            "flux state: wrote %d keys, %d/%d bytes"
            % (len(state), len(serialized.encode("utf-8")), budget)
        )
        cap = budget * STATE_LOG_BUDGET_MULTIPLE
        if os.path.getsize(path) > cap:
            before, after = compact_log(path)
            print("flux state: compacted %s — %d records -> %d, log was over "
                  "%d bytes (%dx the pack budget)"
                  % (STATE_LOG_NAME, before, after, cap, STATE_LOG_BUDGET_MULTIPLE))
        _touch_wrap(root)  # a state write is the wrap breadcrumb seal reads
        return 0
    if args[0] == "log":
        return cmd_state_log(root, args[1:])
    if args[0] == "compact":
        path = state_log_path(root)
        if not os.path.isfile(path):
            print("flux state: no %s to compact" % STATE_LOG_NAME, file=sys.stderr)
            return 1
        before, after = compact_log(path)
        print("flux state: compacted %s — %d records -> %d"
              % (STATE_LOG_NAME, before, after))
        return 0
    print("usage: flux state get [key...] | set <key> <value>... | log [N] | compact",
          file=sys.stderr)
    return 2


STATE_LOG_DEFAULT_N = 20
STATE_LOG_VALUE_CHARS = 120

def cmd_state_log(root, args):
    """What an append-only format buys that a rewritten file cannot: the previous
    value is still there after a bad write. Capped -- it prints into a session."""
    path = state_log_path(root)
    if not os.path.isfile(path):
        print("flux state: no %s here (legacy %s keeps no history)"
              % (STATE_LOG_NAME, STATE_LOG_LEGACY), file=sys.stderr)
        return 1
    try:
        count = max(1, int(args[0])) if args else STATE_LOG_DEFAULT_N
    except ValueError:
        print("usage: flux state log [N]", file=sys.stderr)
        return 2
    records = read_log(path)
    for rec in reversed(records[-count:]):
        value = str(rec.get("v", ""))
        if len(value) > STATE_LOG_VALUE_CHARS:
            value = value[:STATE_LOG_VALUE_CHARS] + "…"
        print("%s  %-9s %s" % (local_stamp(str(rec.get("ts", ""))), rec["k"],
                               value or "(cleared)"))
    if len(records) > count:
        print("... +%d older (flux state log %d)" % (len(records) - count, len(records)))
    return 0


def migrate_legacy(root):
    """One-way, on first write: state.toml -> state.jsonl, then the old file goes.

    Leaving it in place would leave a stale copy of the one file a human reads to
    learn where the project is. Its content is in the log, and in git if it was
    tracked."""
    fdir = flux_dir(root)
    legacy = os.path.join(fdir, STATE_LOG_LEGACY)
    log = state_log_path(root)
    if os.path.exists(log) or not os.path.isfile(legacy):
        return False
    try:
        old = {k: v for k, v in load_toml(legacy).items() if not isinstance(v, dict)}
    except Exception:
        old = {}
    stamp = now_iso()
    pairs = [(k, str(v)) for k, v in order_state(old).items()
             if k not in STATE_DERIVED_KEYS and str(v) != ""]
    append_records(log, pairs, stamp)
    os.remove(legacy)
    write_gitattributes(fdir)
    print("flux state: migrated %d keys from %s to the append-only %s "
          "(commit it — .flux/.gitattributes union-merges it)"
          % (len(pairs), STATE_LOG_LEGACY, STATE_LOG_NAME))
    return True

# ------------------------------------------------------------- the task index
#
# Same append-only discipline as state.jsonl, and for the same reason: two branches
# that both worked must merge, not conflict. The record shape differs -- state
# records carry a key and a value, task records carry an id and an op -- so this
# reuses read_log's *posture* (skip what you cannot parse, never raise) and
# winners()' ordering rule, not their code.
#
# Everything derived is derived on read. `blocked` is not a stored field, and
# neither is "which task is next": a stored flag is wrong the moment its blocker
# closes, and a frontier that has to be re-derived by reading is exactly the cost
# this index exists to remove.

# An add record is stored state, so it is capped like everything else flux keeps.
TASK_RECORD_MAX_BYTES = 1024
TASK_TITLE_MAX = 120
# prime's task line rides inside the pack budget but carries its own cap: one long
# title must not crowd out the rest of the pack.
TASK_LINE_BUDGET = 200
# An awaiting task's steps ride the pack under their own cap (ADR 0004 §4: prime
# clips, the handoff carries them whole).
TASK_AWAIT_BUDGET = 300
TASK_STEPS_ROW_BYTES = 80  # the `list` row shows a glimpse; `next` prints them whole
DEFAULT_LEASE_HOURS = 12
TASK_TIERS = ("tracer", "fill")

_TASK_USAGE = (
    'usage: flux task add "<title>" [--files a,b] [--blocked-by t-x,t-y] '
    '[--verify "<cmd>"] [--ref <path>]\n'
    '                     [--tier tracer|fill] [--tracer <id>]\n'
    '       flux task start <id> | done <id> --by "<what verified it>"\n'
    '       flux task escalate <id> [--why "…"] | await <id> --steps "…" '
    '| reopen <id> [--why "…"]\n'
    '       flux task list [--open|--awaiting|--done|--all] | next [--all] | compact'
)
_TASK_DONE_USAGE = 'usage: flux task done <id> --by "<what verified it>"'
_TASK_ADD_FLAGS = {"--files": "files", "--blocked-by": "blocked_by",
                   "--verify": "verify", "--ref": "ref",
                   "--tier": "tier", "--tracer": "tracer"}


def tasks_path(root):
    return os.path.join(flux_dir(root), TASKS_LOG_NAME)

def _task_cfg(cfg, key, default):
    """A [task] key as int, else the code default. Separate from _guard_cfg, which
    is hardcoded to [guard] -- generalising it would let a typo in one table read
    out of the other."""
    table = cfg.get("task") if cfg else None
    if isinstance(table, dict) and key in table:
        try:
            return int(table[key])
        except (TypeError, ValueError):
            return default
    return default

def read_task_log(path):
    """Records in file order. Unparseable lines are skipped, never raised -- a union
    merge can leave a line git could not join, and this is the file that says what
    is left to do."""
    records = []
    try:
        with open(path, encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line.startswith("{"):
                    continue
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                if (isinstance(rec, dict)
                        and isinstance(rec.get("id"), str) and rec["id"]
                        and isinstance(rec.get("op"), str) and rec["op"]):
                    records.append(rec)
    except OSError:
        return []
    return records

def task_id(ts, title):
    """`t-` + 4 base32 chars of sha1(ts \\n title). Content-addressed, never counted:
    two clones adding tasks offline cannot collide on a counter, and an id that
    encodes no position cannot be renumbered by a merge."""
    digest = hashlib.sha1((ts + "\n" + title).encode("utf-8")).digest()
    return "t-" + base64.b32encode(digest).decode("ascii")[:4].lower()

def _where(root):
    """Who holds a task: short hostname : worktree basename. It is the only thing a
    second machine ever sees of the first."""
    try:
        host = socket.gethostname().split(".")[0]
    except Exception:
        host = "?"
    return "%s:%s" % (host or "?", os.path.basename(os.path.realpath(root)))

def _csv(raw):
    return [part.strip() for part in str(raw or "").split(",") if part.strip()]

def _str_list(value):
    if not isinstance(value, list):
        return []
    return [str(x) for x in value if isinstance(x, (str, int, float))]


def _task_ops(records):
    """-> [(ts, file position, op, id, payload)], with compaction's folded fields
    expanded back into synthetic start/done ops at their own stamps.

    Expanding rather than seeding "initial state, then later ops" is what makes
    compaction safe under merge: a clone that compacted after `done` and a clone
    that appended an *earlier* `start` must still replay to done."""
    ops = []
    for i, rec in enumerate(records):
        tid = rec["id"]
        ts = str(rec.get("ts", ""))
        ops.append((ts, i, rec["op"], tid, rec))
        if rec["op"] != "add":
            continue
        # Every folded terminal field becomes an op at its own stamp, in the order
        # the stamps say -- a reopen folded at T cannot be undone by a merged `done`
        # stamped before T, because that done replays first.
        if rec.get("escalate_ts"):
            ops.append((str(rec["escalate_ts"]), i, "escalate", tid,
                        {"why": str(rec.get("escalated", ""))}))
        if rec.get("reopen_ts"):
            ops.append((str(rec["reopen_ts"]), i, "reopen", tid,
                        {"why": str(rec.get("why", ""))}))
        status = rec.get("status")
        if status not in ("active", "done", "awaiting"):
            continue
        starts = _str_list(rec.get("starts"))
        if not starts and rec.get("where"):
            starts = [str(rec["where"])]
        start_ts = str(rec.get("start_ts") or ts)
        for where in starts:
            ops.append((start_ts, i, "start", tid, {"where": where}))
        if status == "done":
            ops.append((str(rec.get("done_ts") or ts), i, "done", tid,
                        {"by": str(rec.get("by", ""))}))
        elif status == "awaiting":
            ops.append((str(rec.get("await_ts") or ts), i, "await", tid,
                        {"steps": str(rec.get("steps", ""))}))
    return ops

def _new_task(tid):
    return {"id": tid, "ts": "", "title": "", "files": [], "blocked_by": [],
            "verify": "", "ref": "", "status": "open", "where": "", "by": "",
            "starts": [], "start_ts": "", "done_ts": "",
            "tier": "tracer", "tracer": "", "escalated": "", "escalate_ts": "",
            "steps": "", "await_ts": "", "reopen_ts": "", "reopen_why": "",
            "_add": False, "_closed": False}

def replay_tasks(records):
    """-> {id: task}, in (add ts, id) order. Ops are ordered by (ts, file position)
    -- winners() semantics -- and the last one decides the status.

    An id with no `add` op is an orphan (a merge can deliver a `done` whose `add`
    lives on a branch nobody merged) and is dropped rather than guessed at."""
    tasks = {}
    for ts, _pos, op, tid, rec in sorted(_task_ops(records), key=lambda o: (o[0], o[1])):
        task = tasks.get(tid)
        if task is None:
            task = tasks[tid] = _new_task(tid)
        if op == "add":
            task["_add"] = True
            task["ts"] = ts
            task["title"] = str(rec.get("title", ""))
            task["files"] = _str_list(rec.get("files"))
            task["blocked_by"] = _str_list(rec.get("blocked_by"))
            task["verify"] = str(rec.get("verify", ""))
            task["ref"] = str(rec.get("ref", ""))
            # Absent means tracer: the tier every 2.12.0 record has. The safe default
            # keeps the work in the parent -- a fill run there is merely slow.
            task["tier"] = rec.get("tier") if rec.get("tier") in TASK_TIERS else "tracer"
            task["tracer"] = str(rec.get("tracer") or "")
            task["status"] = "open"
        elif op == "start":
            if task["_closed"]:  # a start after a done opens a new segment
                task["starts"] = []
                task["_closed"] = False
            task["where"] = str(rec.get("where", ""))
            task["starts"].append(task["where"])
            task["start_ts"] = ts
            task["status"] = "active"
        elif op == "done":
            task["by"] = str(rec.get("by", ""))
            task["done_ts"] = ts
            task["_closed"] = True
            task["status"] = "done"
        elif op == "escalate":
            # Tier only ever rises. The task goes back to open: whoever raised it has
            # handed it back, and the next tracer session picks it up -- so the
            # start segment resets too, or that pickup reads as a two-machine conflict.
            task["starts"] = []
            task["where"] = ""
            task["tier"] = "tracer"
            task["escalated"] = str(rec.get("why", ""))
            task["escalate_ts"] = ts
            task["status"] = "open"
        elif op == "await":
            task["steps"] = str(rec.get("steps", ""))
            task["await_ts"] = ts
            task["status"] = "awaiting"
        elif op == "reopen":
            # From done or awaiting; the segment restarts so a stale `where`, `by`
            # or `steps` cannot describe work that is open again.
            task["starts"] = []
            task["where"] = ""
            task["by"] = ""
            task["done_ts"] = ""
            task["steps"] = ""
            task["await_ts"] = ""
            task["reopen_ts"] = ts
            task["reopen_why"] = str(rec.get("why", ""))
            task["_closed"] = False
            task["status"] = "open"
        # anything else: recorded as a touch, ignored for status
    live = [t for t in tasks.values() if t["_add"]]
    live.sort(key=lambda t: (t["ts"], t["id"]))
    ordered = {}
    for task in live:
        del task["_add"]
        del task["_closed"]
        ordered[task["id"]] = task
    return ordered

def task_order(tasks):
    """(add ts, id) -- the one order list, next and compaction all use."""
    return sorted(tasks, key=lambda tid: (tasks[tid]["ts"], tid))

def task_blockers(tasks, tid):
    """The declared blockers that are not done, unknown ids marked `?`. An unknown
    id blocks forever: it names a task this clone has not seen, so it cannot be
    known to be done."""
    task = tasks.get(tid)
    if not task:
        return []
    deps = list(task["blocked_by"])
    if task["tracer"] and task["tracer"] not in deps:
        deps.append(task["tracer"])  # a fill implicitly waits on the slice it widens
    out = []
    for dep in deps:
        known = tasks.get(dep)
        if known is None:
            out.append("?" + dep)
        elif known["status"] != "done":
            out.append(dep)
    return out

def task_blocked(tasks, tid):
    return bool(task_blockers(tasks, tid))

def task_counts(tasks):
    """-> (open, blocked, done, awaiting, escalated). `open` is everything not done
    (active and awaiting tasks are still work in flight); `blocked` and `awaiting`
    are subsets of it. `escalated` counts every task that was ever escalated, done
    or not -- it is the numerator of the escalation rate, read by hand until the
    ledger metric lands."""
    live = [tid for tid in tasks if tasks[tid]["status"] != "done"]
    return (len(live),
            sum(1 for tid in live if task_blocked(tasks, tid)),
            len(tasks) - len(live),
            sum(1 for tid in live if tasks[tid]["status"] == "awaiting"),
            sum(1 for tid in tasks if tasks[tid]["escalate_ts"]))

def _task_count_line(tasks):
    n_open, n_blocked, n_done, n_await, n_esc = task_counts(tasks)
    line = "%d open, %d blocked, %d done" % (n_open, n_blocked, n_done)
    if n_await:
        line += ", %d awaiting" % n_await
    if n_esc:
        line += ", %d escalated" % n_esc
    return line

def append_task(path, rec):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "a", encoding="utf-8") as f:
        f.write(json.dumps(rec, ensure_ascii=False) + "\n")

def compact_tasks(path):
    """One record per id -- the add record with the terminal op folded in. Sorted by
    (ts, id), so two clones compacting the same log write identical bytes.

    Done tasks are never dropped (there is no archive file), so this bounds op
    noise, not the file. Returns (records before, records after)."""
    records = read_task_log(path)
    tasks = replay_tasks(records)
    out = []
    for tid in task_order(tasks):
        task = tasks[tid]
        rec = {"ts": task["ts"], "id": tid, "op": "add", "title": task["title"]}
        for field in ("files", "blocked_by", "verify", "ref"):
            if task[field]:
                rec[field] = task[field]
        # The folded tier is the *current* one; the original fill-ness survives as
        # the presence of `escalated`. A plain tracer stays unmarked (absent = tracer).
        if task["escalate_ts"]:
            rec["tier"] = "tracer"
            rec["escalated"] = task["escalated"]
            rec["escalate_ts"] = task["escalate_ts"]
        elif task["tier"] == "fill":
            rec["tier"] = "fill"
        if task["tracer"]:
            rec["tracer"] = task["tracer"]
        if task["reopen_ts"] and task["status"] != "done":
            # Kept while the task is open again, so a merged earlier `done` replays
            # before the reopen and cannot resurrect it.
            rec["reopen_ts"] = task["reopen_ts"]
            if task["reopen_why"]:
                rec["why"] = task["reopen_why"]
        if task["status"] == "done":
            rec["status"] = "done"
            rec["by"] = task["by"]
            rec["done_ts"] = task["done_ts"]
        elif task["status"] == "active":
            rec["status"] = "active"
            rec["where"] = task["where"]
            rec["start_ts"] = task["start_ts"]
        elif task["status"] == "awaiting":
            rec["status"] = "awaiting"
            rec["steps"] = task["steps"]
            rec["await_ts"] = task["await_ts"]
            if task["start_ts"]:
                rec["start_ts"] = task["start_ts"]
        if task["status"] in ("done", "active", "awaiting") and task["starts"]:
            # Carried so the `[2 starts]` conflict flag survives compaction.
            rec["starts"] = task["starts"]
        out.append(rec)
    out.sort(key=lambda r: (r["ts"], r["id"]))
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        for rec in out:
            f.write(json.dumps(rec, ensure_ascii=False) + "\n")
    os.replace(tmp, path)
    return len(records), len(out)

def _task_maybe_compact(cfg, path):
    """The same 8x trigger `state set` uses. The notice goes to stderr because
    `flux task add` prints the id alone on stdout, so `$(flux task add …)` composes."""
    cap = state_budget_bytes(cfg) * STATE_LOG_BUDGET_MULTIPLE
    try:
        if os.path.getsize(path) <= cap:
            return
    except OSError:
        return
    before, after = compact_tasks(path)
    if before > after:
        print("flux task: compacted %s — %d records -> %d, log was over %d bytes "
              "(%dx the pack budget)"
              % (TASKS_LOG_NAME, before, after, cap, STATE_LOG_BUDGET_MULTIPLE),
              file=sys.stderr)

# ------------------------------------------------------------- leases
#
# A lease says "this worktree is on this task", and it lives under git's *common*
# dir so every worktree of the repo sees the same one -- while never being a
# tracked file that a merge could conflict on. It is advisory and expiring: a
# machine that dies holds a task for `[task] lease_hours`, not forever.

_LEASE_DIRS = {}

def _lease_dir(root):
    """<git-common-dir>/flux/leases, or None outside a git repo.

    The rev-parse must run at root: git answers relative to cwd (`.git` at the
    toplevel, `../.git` from a subdir, absolute in a linked worktree), so the answer
    is joined to root. On failure this returns None rather than falling through to
    <root>/flux/leases inside the working tree.

    Memoised: `next` and prime ask once per candidate task, and a subprocess per task
    on every SessionStart is exactly the cost this index exists to remove. The CLI is
    one-shot, so a process-lifetime cache cannot go stale."""
    if root in _LEASE_DIRS:
        return _LEASE_DIRS[root]
    common = git(["rev-parse", "--git-common-dir"], cwd=root)
    ldir = None
    if common:
        if not os.path.isabs(common):
            common = os.path.join(root, common)
        ldir = os.path.join(common, "flux", "leases")
    _LEASE_DIRS[root] = ldir
    return ldir

def _lease_path(root, tid):
    ldir = _lease_dir(root)
    return os.path.join(ldir, "%s.json" % tid) if ldir else None

def _lease_read(root, tid):
    """The lease as a dict; {} for absent, unreadable or malformed -- all of which
    mean dead and overwritable."""
    path = _lease_path(root, tid)
    if not path:
        return {}
    try:
        with open(path, encoding="utf-8") as f:
            obj = json.load(f)
        return obj if isinstance(obj, dict) else {}
    except Exception:
        return {}

def _lease_write(root, tid):
    path = _lease_path(root, tid)
    if not path:
        return False
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            json.dump({"ts": now_iso(), "where": _where(root),
                       "worktree": os.path.realpath(root)}, f)
        return True
    except OSError:
        return False

def _lease_clear(root, tid):
    path = _lease_path(root, tid)
    if not path:
        return
    try:
        os.remove(path)
    except OSError:
        pass

def _lease_live(lease, cfg):
    """Live iff it parses, is younger than [task] lease_hours, and its worktree
    still exists on disk -- a deleted worktree's lease is dead, not a 12h block."""
    if not isinstance(lease, dict):
        return False
    worktree = lease.get("worktree")
    if not isinstance(worktree, str) or not worktree:
        return False
    epoch = _iso_epoch(lease.get("ts"))
    if epoch is None:
        return False
    hours = _task_cfg(cfg, "lease_hours", DEFAULT_LEASE_HOURS)
    if (time.time() - epoch) > hours * 3600:
        return False
    return os.path.isdir(worktree)

def _lease_is_ours(lease, root):
    """realpath on both sides: macOS hands out /var and /private/var for one dir."""
    return os.path.realpath(str(lease.get("worktree", ""))) == os.path.realpath(root)

def _clear_own_leases(root):
    """Every lease this worktree holds, plus every unreadable one. Called by seal, so
    a session that ends without `flux task done` does not park its tasks for 12h."""
    ldir = _lease_dir(root)
    if not ldir or not os.path.isdir(ldir):
        return
    for name in os.listdir(ldir):
        if not name.endswith(".json"):
            continue
        path = os.path.join(ldir, name)
        try:
            with open(path, encoding="utf-8") as f:
                obj = json.load(f)
            ours = isinstance(obj, dict) and _lease_is_ours(obj, root)
        except Exception:
            ours = True  # unreadable: it can never be honoured, so it can only block
        if ours:
            try:
                os.remove(path)
            except OSError:
                pass

def _task_candidates(root, cfg, tasks):
    """Runnable ids, best first. Candidate = not done, not blocked, no live lease
    held by another worktree. Rank 1 is an active task this worktree already holds
    (finish what you started), rank 2 is everything else -- open, or active with no
    live lease at all, which is what a sealed or expired lease leaves behind.

    Rank -1 is a task awaiting a person: it is the first thing any session should
    surface, and leases do not apply -- `await` cleared it, and nobody holds it.

    Same input, same answer, twice: the only tie-break is (add ts, id)."""
    ranked = []
    for tid in task_order(tasks):
        task = tasks[tid]
        if task["status"] == "done" or task_blocked(tasks, tid):
            continue
        if task["status"] == "awaiting":
            ranked.append((-1, task["ts"], tid))
            continue
        lease = _lease_read(root, tid)
        rank = 1
        if _lease_live(lease, cfg):
            if not _lease_is_ours(lease, root):
                continue
            if task["status"] == "active":
                rank = 0
        ranked.append((rank, task["ts"], tid))
    ranked.sort()
    return [tid for _rank, _ts, tid in ranked]


def cmd_task(args):
    root = repo_root()
    cfg = read_config(root)
    if cfg is None:
        print("flux task: no .flux/flux.toml here — run `flux init` first",
              file=sys.stderr)
        return 1
    handler = {"add": _task_add, "start": _task_start, "done": _task_done,
               "escalate": _task_escalate, "await": _task_await,
               "reopen": _task_reopen, "list": _task_list, "next": _task_next,
               "compact": _task_compact}.get(args[0] if args else "")
    if handler is None:
        print(_TASK_USAGE, file=sys.stderr)
        return 2
    return handler(root, cfg, args[1:])

def _task_add(root, cfg, args):
    opts, pos, i = {}, [], 0
    while i < len(args):
        arg = args[i]
        if arg in _TASK_ADD_FLAGS:
            if i + 1 >= len(args):
                print("flux task: %s needs a value\n%s" % (arg, _TASK_USAGE),
                      file=sys.stderr)
                return 2
            opts[_TASK_ADD_FLAGS[arg]] = args[i + 1]  # values verbatim: a title or a
            i += 2                                    # command may legitimately lead
            continue                                  # with a dash
        if arg.startswith("-"):
            # The `state set` dash guard. A mistyped flag taken as a positional adds a
            # task titled "--flies", reports success, and is found weeks later.
            print("flux task: %s looks like a flag, not a title\n%s"
                  % (arg, _TASK_USAGE), file=sys.stderr)
            return 2
        pos.append(arg)
        i += 1
    if len(pos) != 1 or not pos[0].strip():
        print("flux task: add takes exactly one <title>\n%s" % _TASK_USAGE,
              file=sys.stderr)
        return 2
    title = pos[0].strip()
    if len(title) > TASK_TITLE_MAX:
        print("flux task: title is %d characters, max is %d — the title is an index "
              "entry, not the spec (point --ref at that)"
              % (len(title), TASK_TITLE_MAX), file=sys.stderr)
        return 2
    tier = opts.get("tier") or "tracer"
    if tier not in TASK_TIERS:
        print("flux task: --tier is tracer or fill, not %r\n%s" % (tier, _TASK_USAGE),
              file=sys.stderr)
        return 2
    if opts.get("tracer") and tier != "fill":
        print("flux task: --tracer names the slice a *fill* widens; a tracer has "
              "none\n%s" % _TASK_USAGE, file=sys.stderr)
        return 2
    stamp = now_iso()
    tid = task_id(stamp, title)
    path = tasks_path(root)
    tasks = replay_tasks(read_task_log(path))
    if tid in tasks:
        print("flux task: id collision on %s, re-run (the stamp carries "
              "milliseconds, so a re-run is a different id)" % tid, file=sys.stderr)
        return 1
    tracer = opts.get("tracer") or ""
    if tracer:
        parent = tasks.get(tracer)
        if parent is None:
            print("flux task: no such task %s to be the tracer of" % tracer,
                  file=sys.stderr)
            return 1
        if parent["tier"] != "tracer":
            print("flux task: %s is a fill, not a tracer — a fill widens a tracer's "
                  "slice, never another fill's" % tracer, file=sys.stderr)
            return 1
    rec = {"ts": stamp, "id": tid, "op": "add", "title": title}
    for field in ("files", "blocked_by"):
        value = _csv(opts.get(field))
        if value:
            rec[field] = value
    for field in ("verify", "ref"):
        if opts.get(field):
            rec[field] = opts[field]
    if tier == "fill":  # absent means tracer, so a tracer record stays 2.12.0-shaped
        rec["tier"] = "fill"
        if tracer:
            rec["tracer"] = tracer
    if not _task_record_fits(rec, "Trim --verify/--files; a spec belongs behind --ref."):
        return 1
    append_task(path, rec)
    write_gitattributes(flux_dir(root))
    print(tid)
    _task_maybe_compact(cfg, path)
    return 0

def _task_record_fits(rec, hint):
    """Checked before appending, so a refused write leaves the log exactly as it
    was. Every record flux stores is capped, ops included -- a 2 KB `--steps` is a
    spec, and specs go behind --ref."""
    size = len(json.dumps(rec, ensure_ascii=False).encode("utf-8"))
    if size > TASK_RECORD_MAX_BYTES:
        print("flux task: refused — record would be %d bytes, TASK_RECORD_MAX_BYTES "
              "is %d. %s" % (size, TASK_RECORD_MAX_BYTES, hint), file=sys.stderr)
        return False
    return True

def _task_one_id(args, usage):
    """-> (id, None) or (None, exit code). The dash guard again: an id positional."""
    if len(args) != 1 or not args[0] or args[0].startswith("-"):
        print(usage, file=sys.stderr)
        return None, 2
    return args[0], None

def _task_id_and_flag(args, flag, usage):
    """`<id> [<flag> <value>]` -> (id, value, None) or (None, None, exit code).
    The value is verbatim (a `why` may lead with a dash); the id is dash-guarded."""
    value, pos, i = "", [], 0
    while i < len(args):
        arg = args[i]
        if arg == flag:
            if i + 1 >= len(args):
                print(usage, file=sys.stderr)
                return None, None, 2
            value = args[i + 1]
            i += 2
            continue
        if arg.startswith("-"):
            print("flux task: %s looks like a flag, not an id\n%s" % (arg, usage),
                  file=sys.stderr)
            return None, None, 2
        pos.append(arg)
        i += 1
    if len(pos) != 1 or not pos[0]:
        print(usage, file=sys.stderr)
        return None, None, 2
    return pos[0], value, None

def _task_load(root, tid):
    """-> (path, tasks, task) or (path, tasks, None) with the `no such task` line
    already printed."""
    path = tasks_path(root)
    tasks = replay_tasks(read_task_log(path))
    task = tasks.get(tid)
    if task is None:
        print("flux task: no such task %s" % tid, file=sys.stderr)
    return path, tasks, task

def _task_held_elsewhere(root, cfg, tid, verb):
    lease = _lease_read(root, tid)
    if _lease_live(lease, cfg) and not _lease_is_ours(lease, root):
        print("flux task: %s is held by %s — that session owns %s it"
              % (tid, lease.get("where", "?"), verb), file=sys.stderr)
        return True
    return False

def _task_escalate(root, cfg, args):
    """fill -> tracer, one direction. What a subagent handed back with NEEDS_CONTEXT
    or BLOCKED goes in `why`; the task returns to open for a tracer session."""
    usage = 'usage: flux task escalate <id> [--why "<what the subagent said>"]'
    tid, why, code = _task_id_and_flag(args, "--why", usage)
    if code is not None:
        return code
    path, _tasks, task = _task_load(root, tid)
    if task is None:
        return 1
    if task["status"] == "done":
        print("flux task: %s is done — nothing to escalate" % tid, file=sys.stderr)
        return 1
    if task["status"] == "awaiting":
        print("flux task: %s is awaiting a person — resolve it with done --by or "
              "reopen first" % tid, file=sys.stderr)
        return 1
    if task["tier"] == "tracer":
        print("flux task: %s is already a tracer — tier only ever rises" % tid,
              file=sys.stderr)
        return 1
    if _task_held_elsewhere(root, cfg, tid, "escalating"):
        return 1
    rec = {"ts": now_iso(), "id": tid, "op": "escalate"}
    if why.strip():
        rec["why"] = why
    if not _task_record_fits(rec, "Trim --why; the detail belongs in the spec."):
        return 1
    append_task(path, rec)
    _lease_clear(root, tid)  # a batch moves on; nobody holds it
    print("flux task: escalate %s  %s" % (tid, task["title"]))
    return 0

def _task_await(root, cfg, args):
    """The verify is a human observation. The steps are what the person does; the
    session ends here and the next one surfaces them first."""
    usage = 'usage: flux task await <id> --steps "<what the person does to verify>"'
    tid, steps, code = _task_id_and_flag(args, "--steps", usage)
    if code is not None:
        return code
    if not steps.strip():
        print(usage, file=sys.stderr)
        return 2
    path, _tasks, task = _task_load(root, tid)
    if task is None:
        return 1
    if task["status"] == "done":
        print("flux task: %s is done — nothing to await" % tid, file=sys.stderr)
        return 1
    if task["status"] == "awaiting":
        print("flux task: %s is already awaiting a person — resolve it with done "
              "--by or reopen first" % tid, file=sys.stderr)
        return 1
    if _task_held_elsewhere(root, cfg, tid, "parking"):
        return 1
    rec = {"ts": now_iso(), "id": tid, "op": "await", "steps": steps}
    if not _task_record_fits(rec, "Trim --steps; the detail belongs in the spec."):
        return 1
    append_task(path, rec)
    _lease_clear(root, tid)  # no session holds a task a person is verifying
    print("flux task: await %s  %s" % (tid, task["title"]))
    return 0

def _task_reopen(root, _cfg, args):
    """From awaiting (the observation failed) or done (a verify failed on replay).
    Tier is untouched; the start segment resets."""
    usage = 'usage: flux task reopen <id> [--why "<what failed>"]'
    tid, why, code = _task_id_and_flag(args, "--why", usage)
    if code is not None:
        return code
    path, _tasks, task = _task_load(root, tid)
    if task is None:
        return 1
    if task["status"] not in ("done", "awaiting"):
        print("flux task: %s is %s, not closed — reopen takes a done or awaiting task"
              % (tid, task["status"]), file=sys.stderr)
        return 1
    rec = {"ts": now_iso(), "id": tid, "op": "reopen"}
    if why.strip():
        rec["why"] = why
    if not _task_record_fits(rec, "Trim --why."):
        return 1
    append_task(path, rec)
    print("flux task: reopen %s  %s" % (tid, task["title"]))
    return 0

def _task_start(root, cfg, args):
    tid, code = _task_one_id(args, "usage: flux task start <id>")
    if code is not None:
        return code
    path = tasks_path(root)
    tasks = replay_tasks(read_task_log(path))
    task = tasks.get(tid)
    if task is None:
        print("flux task: no such task %s" % tid, file=sys.stderr)
        return 1
    if task["status"] == "done":
        # Last-op-wins replay would happily make this a reopen; `reopen` is the verb
        # for that, with its own semantics, so an undocumented path is worse than none.
        print("flux task: %s is already done — reopening is not a verb; "
              "`flux task reopen %s` is" % (tid, tid), file=sys.stderr)
        return 1
    if task["status"] == "awaiting":
        print("flux task: %s is awaiting a person — done --by or reopen" % tid,
              file=sys.stderr)
        return 1
    blockers = task_blockers(tasks, tid)
    if blockers:
        print("flux task: %s is blocked by %s" % (tid, ", ".join(blockers)),
              file=sys.stderr)
        return 1
    if _lease_dir(root) is None:
        print("flux task: cannot lease: not a git repo", file=sys.stderr)
        return 1
    lease = _lease_read(root, tid)
    if _lease_live(lease, cfg) and not _lease_is_ours(lease, root):
        print("flux task: %s is held by %s since %s — run `flux seal` there, or wait "
              "for the lease to expire" % (tid, lease.get("where", "?"),
                                           lease.get("ts", "?")), file=sys.stderr)
        return 1
    append_task(path, {"ts": now_iso(), "id": tid, "op": "start",
                       "where": _where(root)})
    _lease_write(root, tid)
    print("flux task: started %s  %s" % (tid, task["title"]))
    return 0

def _task_done(root, cfg, args):
    by, pos, i = "", [], 0
    while i < len(args):
        arg = args[i]
        if arg == "--by":
            if i + 1 >= len(args):
                print(_TASK_DONE_USAGE, file=sys.stderr)
                return 2
            by = args[i + 1]
            i += 2
            continue
        if arg.startswith("-"):
            print("flux task: %s looks like a flag, not an id\n%s"
                  % (arg, _TASK_DONE_USAGE), file=sys.stderr)
            return 2
        pos.append(arg)
        i += 1
    if len(pos) != 1 or not by.strip():
        print(_TASK_DONE_USAGE, file=sys.stderr)
        return 2
    tid = pos[0]
    path = tasks_path(root)
    tasks = replay_tasks(read_task_log(path))
    task = tasks.get(tid)
    if task is None:
        print("flux task: no such task %s" % tid, file=sys.stderr)
        return 1
    if task["status"] == "done":
        print("flux task: %s is already done — by: %s" % (tid, task["by"]),
              file=sys.stderr)
        return 1
    lease = _lease_read(root, tid)
    if _lease_live(lease, cfg) and not _lease_is_ours(lease, root):
        print("flux task: %s is held by %s — that session owns closing it"
              % (tid, lease.get("where", "?")), file=sys.stderr)
        return 1
    # append -> compact -> unlink: a crash between them leaves a stale lease on a
    # done task, which is harmless, rather than a done record that never landed.
    append_task(path, {"ts": now_iso(), "id": tid, "op": "done", "by": by})
    _task_maybe_compact(cfg, path)
    _lease_clear(root, tid)
    print("flux task: done %s  %s" % (tid, task["title"]))
    return 0

def _task_row(tasks, tid):
    task = tasks[tid]
    row = "%s  %s  %s" % (tid, task["status"], task["title"])
    if task["status"] == "active" and task["where"]:
        row += " @%s" % task["where"]
    blockers = task_blockers(tasks, tid)
    if blockers:
        row += " (blocked by %s)" % ", ".join(blockers)
    seen = []
    for where in task["starts"]:
        if where and where not in seen:
            seen.append(where)
    if len(seen) > 1:
        # Two machines started the same task and neither saw the other's lease.
        row += " [%d starts: %s]" % (len(seen), ", ".join(seen))
    if task["tier"] == "fill":  # tracer is the unmarked default
        row += " [fill of %s]" % task["tracer"] if task["tracer"] else " [fill]"
    if task["escalate_ts"]:
        row += " [escalated]"
    if task["status"] == "awaiting":
        row += " (awaiting: %s)" % clip(task["steps"], TASK_STEPS_ROW_BYTES, marker="…")
    if task["status"] == "done" and task["by"]:
        row += " — by: %s" % task["by"]
    return row

def _task_list(root, cfg, args):
    unknown = [a for a in args if a not in ("--open", "--awaiting", "--done", "--all")]
    if unknown:
        print("usage: flux task list [--open|--awaiting|--done|--all]", file=sys.stderr)
        return 2
    path = tasks_path(root)
    tasks = replay_tasks(read_task_log(path))
    if not tasks:
        print("flux task: no tasks yet — `flux task add \"…\"`")
        return 0
    if "--all" in args:
        shown = task_order(tasks)
    elif "--done" in args:
        shown = [t for t in task_order(tasks) if tasks[t]["status"] == "done"]
    elif "--awaiting" in args:
        shown = [t for t in task_order(tasks) if tasks[t]["status"] == "awaiting"]
    elif "--open" in args:
        shown = [t for t in task_order(tasks) if tasks[t]["status"] == "open"]
    else:
        shown = [t for t in task_order(tasks) if tasks[t]["status"] != "done"]
    rows = [_task_row(tasks, tid) for tid in shown]
    rows.append(_task_count_line(tasks))
    print(clip("\n".join(rows), state_budget_bytes(cfg)))
    return 0

def _task_next_line(task):
    line = "%s  %s" % (task["id"], task["title"])
    if task["status"] == "awaiting":
        # The person acts, not the session: the steps are the whole instruction.
        return line + " · awaiting: %s" % task["steps"]
    if task["files"]:
        line += " · files: %s" % ",".join(task["files"])
    if task["verify"]:
        line += " · verify: %s" % task["verify"]
    if task["ref"]:
        line += " · ref: %s" % task["ref"]
    if task["tier"] == "fill":
        line += " · tier: fill"
        if task["tracer"]:
            line += " · tracer: %s" % task["tracer"]
    return line

def _task_awaiting(root):
    """[(id, title, steps)] for the handoff, add order. [] fast when there is no
    index -- and the handoff's no-awaiting path must not change a byte."""
    path = tasks_path(root)
    if not os.path.isfile(path):
        return []
    tasks = replay_tasks(read_task_log(path))
    return [(tid, tasks[tid]["title"], tasks[tid]["steps"])
            for tid in task_order(tasks) if tasks[tid]["status"] == "awaiting"]

def _task_next(root, cfg, args):
    if [a for a in args if a != "--all"]:
        print("usage: flux task next [--all]", file=sys.stderr)
        return 2
    tasks = replay_tasks(read_task_log(tasks_path(root)))
    candidates = _task_candidates(root, cfg, tasks)
    if not candidates:
        print("no runnable task", file=sys.stderr)
        return 1
    if "--all" not in args:
        candidates = candidates[:1]
    print("\n".join(_task_next_line(tasks[tid]) for tid in candidates))
    return 0

def _task_compact(root, _cfg, args):
    if args:
        print("usage: flux task compact", file=sys.stderr)
        return 2
    path = tasks_path(root)
    if not os.path.isfile(path):
        print("flux task: no %s to compact" % TASKS_LOG_NAME, file=sys.stderr)
        return 1
    before, after = compact_tasks(path)
    print("flux task: compacted %s — %d records -> %d"
          % (TASKS_LOG_NAME, before, after))
    return 0

def _task_pack_lines(root, cfg):
    """-> (task line, derived next line, await line) for prime, all "" when the
    index has nothing live. Returns before any git call when there is no index:
    this runs on every SessionStart in every repo the plugin is installed in."""
    path = tasks_path(root)
    if not os.path.isfile(path):
        return "", "", ""
    tasks = replay_tasks(read_task_log(path))
    live = [tid for tid in task_order(tasks) if tasks[tid]["status"] != "done"]
    if not live:
        return "", "", ""
    candidates = _task_candidates(root, cfg, tasks)
    head = candidates[0] if candidates else live[0]
    task_line = clip("task: %s %s · %s" % (head, tasks[head]["title"],
                                            _task_count_line(tasks)),
                     TASK_LINE_BUDGET, marker="…")
    next_line = await_line = ""
    if candidates:
        nid = candidates[0]
        if tasks[nid]["status"] == "awaiting":
            # The person acts; the pack says what they do and how it resolves.
            await_line = clip("await: %s %s" % (nid, tasks[nid]["steps"]),
                              TASK_AWAIT_BUDGET, marker="…")
            next_line = clip('next: %s %s  [awaiting a person — flux task done %s '
                             '--by "…" | reopen %s]' % (nid, tasks[nid]["title"], nid, nid),
                             TASK_LINE_BUDGET, marker="…")
        else:
            next_line = clip("next: %s %s  [from index — flux task next]"
                             % (nid, tasks[nid]["title"]), TASK_LINE_BUDGET, marker="…")
    return task_line, next_line, await_line

def _task_pack_lines_safe(root, cfg):
    """A broken index must never blank the pack — same posture as the cycle line."""
    try:
        return _task_pack_lines(root, cfg)
    except Exception:
        return "", "", ""

# ----------------------------------------------------------------------- check

FAILURE_RE = re.compile(
    r"(?i)\b(error|errors|fail|failed|failing|failure|failures|exception|traceback|"
    r"assert|panic|fatal)\b|✗|✖|ERR!"
)

def filter_failures(lines, context=2, cap=200):
    keep = set()
    for i, line in enumerate(lines):
        if FAILURE_RE.search(line):
            for j in range(max(0, i - context), min(len(lines), i + context + 1)):
                keep.add(j)
    if not keep:
        return lines[-40:]
    picked = [lines[i] for i in sorted(keep)]
    if len(picked) > cap:
        picked = picked[:cap] + ["[flux: +%d more matching lines suppressed]" % (len(picked) - cap)]
    return picked

def apply_filter(mode, lines):
    if mode == "raw":
        return lines
    if mode.startswith("tail:"):
        try:
            n = int(mode.split(":", 1)[1])
        except ValueError:
            n = 80
        return lines[-n:]
    return filter_failures(lines)

RUN_FILTER_MODES = ("elide", "raw", "failures")

def valid_filter_mode(mode):
    """Modes `flux run --filter` / `[run].filter` accept. `elide` is run's own
    head+tail squeeze; the rest are check's filters, reused verbatim."""
    if mode in RUN_FILTER_MODES:
        return True
    if mode.startswith("tail:"):
        return mode[len("tail:"):].isdigit()
    return False

def _mark_check_verified(root):
    """Flip `verified = false` -> `verified = true` in flux.toml in place,
    preserving every other byte of the user's file."""
    path = os.path.join(flux_dir(root), "flux.toml")
    try:
        with open(path, encoding="utf-8") as f:
            text = f.read()
        new, n = re.subn(r"(?m)^(\s*verified\s*=\s*)false\b", r"\1true", text, count=1)
        if n != 1:
            return False
        tmp = path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(new)
        os.replace(tmp, path)
        return True
    except Exception:
        return False

def cmd_check(_args):
    root = repo_root()
    cfg = read_config(root)
    if cfg is None:
        print("flux check: no .flux/flux.toml here — run `flux init` first", file=sys.stderr)
        return 1
    check_cfg = cfg.get("check") or {}
    command = check_cfg.get("command", "")
    if not command:
        print("flux check: [check].command is empty in .flux/flux.toml", file=sys.stderr)
        return 1
    proc = subprocess.run(
        command, shell=True, cwd=root,
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
    )
    lines = proc.stdout.splitlines()
    if proc.returncode == 0:
        print("check passed: %s (%d lines suppressed)" % (command, len(lines)))
        if check_cfg.get("verified") is False and _mark_check_verified(root):
            print("note: first full pass — [check].command marked verified in .flux/flux.toml")
        return 0
    mode = check_cfg.get("filter", "failures")
    for line in apply_filter(mode, lines):
        print(line)
    print("check FAILED (exit %d): %s [filter=%s, %d raw lines]"
          % (proc.returncode, command, mode, len(lines)))
    if check_cfg.get("verified") is False:
        print("note: this command has never passed here — if the failure looks wrong, "
              "edit [check].command in .flux/flux.toml")
    return proc.returncode

# ------------------------------------------------------------------------- log

_LOG_USAGE = ('usage: flux log <tag> "<text>"  '
              '(tags: audit-hit | pack-miss | want)')


def _append_field_log(root, tag, text):
    fdir = flux_dir(root)
    os.makedirs(fdir, exist_ok=True)
    with open(os.path.join(fdir, FIELD_LOG_NAME), "a", encoding="utf-8") as f:
        f.write("- %s %s  %s\n" % (now_iso(), tag, text))


def cmd_log(args):
    """Append one entry to .flux/field-log.md — the field's own instrument. A user
    command: it errors (not silent) outside a flux repo; the hook-safe seal caller
    is phase 04's concern. The tag is an open bareword so seal can log `unwrapped`."""
    root = repo_root()
    cfg = read_config(root)
    if cfg is None:
        print("flux log: not a flux repo (run `flux init` first)", file=sys.stderr)
        return 2
    if len(args) < 2 or not args[0] or " " in args[0] or not " ".join(args[1:]).strip():
        print(_LOG_USAGE, file=sys.stderr)
        return 2
    tag = args[0]
    text = clip(" ".join(args[1:]).strip(), state_budget_bytes(cfg))
    _append_field_log(root, tag, text)
    return 0

# --------------------------------------------------------------------- handoff

def cmd_handoff(_args):
    root = repo_root()
    cfg = read_config(root)
    if cfg is None:
        print("flux handoff: no .flux/flux.toml here — run `flux init` first", file=sys.stderr)
        return 1
    state = read_state(root)

    sections = ["# handoff — %s" % now_stamp(), ""]
    branch = git(["branch", "--show-current"], cwd=root) or "(detached)"
    sections.append("branch: %s" % branch)
    sections.append("")
    sections.append("## state")
    for key, value in state.items():
        if str(value).strip():
            sections.append("- %s: %s" % (key, value))
    awaiting = _task_awaiting(root)
    if awaiting:
        # Prime clips the steps; the handoff carries them whole (ADR 0004 §4).
        sections.append("")
        sections.append("## awaiting")
        for tid, title, steps in awaiting:
            sections.append("- %s %s" % (tid, title))
            sections.append("  steps: %s" % steps)
    status = git(["status", "--short"], cwd=root)
    sections.append("")
    sections.append("## working tree")
    sections.append("```")
    status_lines = status.splitlines() if status else ["(clean)"]
    sections.extend(status_lines[:40])
    if len(status_lines) > 40:
        sections.append("... +%d more" % (len(status_lines) - 40))
    sections.append("```")
    sections.append("")
    sections.append("## recent commits")
    sections.append("```")
    sections.append(git(["log", "--oneline", "-10"], cwd=root) or "(no commits)")
    sections.append("```")

    content = clip("\n".join(sections) + "\n", handoff_budget_bytes(cfg))
    hdir = os.path.join(flux_dir(root), "handoffs")
    os.makedirs(hdir, exist_ok=True)
    path = os.path.join(hdir, time.strftime("%Y-%m-%d-%H%M") + ".md")
    with open(path, "w", encoding="utf-8") as f:
        f.write(content)
    _touch_wrap(root)  # a handoff is the wrap breadcrumb seal reads
    print(os.path.relpath(path, os.getcwd()))
    return 0

# ------------------------------------------------------------------------- run

def dedupe(lines):
    out = []
    for line in lines:
        if out and out[-1][0] == line:
            out[-1][1] += 1
        else:
            out.append([line, 1])
    result = []
    for line, count in out:
        result.append(line if count == 1 else "%s  [x%d]" % (line, count))
    return result

def cmd_run(args):
    tail = None
    mode = None
    while args and args[0] != "--":
        if args[0] == "--tail" and len(args) >= 2:
            try:
                tail = int(args[1])
            except ValueError:
                print("flux run: --tail wants an integer, got %r" % args[1], file=sys.stderr)
                return 2
            args = args[2:]
        elif args[0] == "--filter" and len(args) >= 2:
            mode = args[1]
            if not valid_filter_mode(mode):
                print("flux run: unknown --filter %r (elide | failures | tail:N | raw)"
                      % mode, file=sys.stderr)
                return 2
            args = args[2:]
        else:
            break
    if args[:1] == ["--"]:
        args = args[1:]
    if not args:
        print("usage: flux run [--tail N] [--filter elide|failures|tail:N|raw] -- <command...>",
              file=sys.stderr)
        return 2
    root = repo_root()
    cfg = read_config(root) or {}
    run_cfg = cfg.get("run") or {}
    if tail is None:
        tail = run_cfg.get("tail", 100)
    if mode is None:
        mode = str(run_cfg.get("filter", "elide"))
        if not valid_filter_mode(mode):
            print("flux run: ignoring unknown [run].filter %r — using elide" % mode,
                  file=sys.stderr)
            mode = "elide"
    proc = subprocess.run(
        args if len(args) > 1 else args[0],
        shell=(len(args) == 1), cwd=os.getcwd(),
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
    )
    lines = [l[:500] + " [flux: line truncated]" if len(l) > 500 else l
             for l in proc.stdout.splitlines()]
    lines = dedupe(lines)
    total = len(lines)
    if mode == "elide":
        if total > tail + 15:
            shown = lines[:15] + ["[flux: %d lines elided]" % (total - tail - 15)] + lines[-tail:]
        else:
            shown = lines
    else:
        shown = apply_filter(mode, lines)
    for line in shown:
        print(line)
    if total != len(shown):
        print("[flux run: %d -> %d lines, filter=%s, exit %d]"
              % (total, len(shown), mode, proc.returncode))
    return proc.returncode

# ------------------------------------------------------------------- ledger
#
# `flux ledger` reads the Claude Code transcripts on disk and prints the targets
# table the 2026-09-03 field read-out computed by hand, per repo, per cycle,
# budgeted -- so principle 5 (every feature names the ledger metric it moves)
# runs from data a session did not have to derive. The 2026-09-03 analyzer is the
# reference; this reproduces it in-process, it does not import it. Dollar figures
# are API-equivalent at list price on a subscription -- a token proxy, labelled so.

PROJECTS_DIR = os.path.expanduser("~/.claude/projects")
# Mirror bench's driver.RETRYABLE_API_STATUSES: a turn that only ever errored on a
# retryable status did no work and must not weigh on any denominator.
RETRYABLE_API_STATUSES = frozenset({"429", "500", "502", "503", "504", "529"})
LEDGER_SUBSTANTIVE_MIN = 5      # main-thread requests for a session to count
LEDGER_CYCLE = 10               # substantive sessions per cycle -- the clock
LEDGER_REQ_CAP = 150            # the runaway-session target line
FLUX_V2_EPOCH = "2026-08-20"    # default --since: the v2 rebuild

_LEDGER_SUB_RE = re.compile(
    r"(?:^|[\s;&|(])(?:\S*/)?flux\s+(init|prime|state|check|handoff|run|ledger|--help|-h)\b")
_LEDGER_STATE_SET_RE = re.compile(r"(?:^|[\s;&|(])(?:\S*/)?flux\s+state\s+set\b")
# A raw-gate call: the repo's test runner invoked directly, bypassing `flux check`
# / `flux run`. Guarded against greps/echoes that merely mention a runner.
_LEDGER_RAW_RE = re.compile(
    r"(?<![\w/=])(?:pytest|py\.test)\b"
    r"|python[0-9.]*\s+-m\s+(?:pytest|unittest)"
    r"|npm\s+run\s+(?:check|test)\b|pnpm\s+(?:test|check)\b|yarn\s+(?:test|check)\b"
    r"|astro\s+build\b|go\s+test\b|cargo\s+test\b|\bmake\s+(?:check|test)\b")
_LEDGER_NONEXEC_RE = re.compile(r"^\s*(?:grep|rg|echo|sed|awk|cat|ls|which|find|#)\b")
_LEDGER_CMDNAME_RE = re.compile(r"<command-name>(/[^<]+)</command-name>")
_PLUGIN_SKILL_MARK = "plugins/cache/marketplace/flux"


def _ledger_price(model, inp, cw, cr, out):
    m = model or ""
    if "haiku" in m:
        rin, rout = 1, 5
    elif "sonnet" in m:
        rin, rout = 3, 15
    else:                       # opus / fable tier
        rin, rout = 15, 75
    return (inp * rin + cw * rin * 1.25 + cr * rin * 0.10 + out * rout) / 1e6


def _median(values):
    xs = sorted(v for v in values if v is not None)
    if not xs:
        return 0
    n = len(xs)
    mid = n // 2
    return xs[mid] if n % 2 else (xs[mid - 1] + xs[mid]) / 2.0


def _slug_for_path(path):
    """Absolute path -> transcript-dir slug: every '/' and '.' becomes '-'."""
    return path.replace("/", "-").replace(".", "-")


_PATH_REVERSAL_BUDGET = 4000     # isdir probes before a slug is declared ambiguous


def _path_for_slug(slug):
    """Reverse the slug rule against the filesystem. '/' and '.' both became '-',
    and path segments carry their own '-', so the split is ambiguous; resolve it by
    testing candidates against real directories. Returns the path, or None if it
    does not resolve to a single existing directory. A pathological slug (many
    dash-separated tokens under a real tree, e.g. a scratchpad worktree) can fan out
    combinatorially, so the probe count is capped — over budget, we give up (None)
    rather than hang; fleet discovery leans on the transcript's `cwd` instead."""
    body = slug[1:] if slug.startswith("-") else slug
    tokens = body.split("-")
    budget = [_PATH_REVERSAL_BUDGET]

    def seg_variants(parts):
        variants = [parts[0]]
        for tok in parts[1:]:
            variants = [v + sep + tok for v in variants for sep in ("-", ".")]
        return variants

    def build(i, base):
        if i == len(tokens):
            return [base]
        found = []
        for k in range(i, len(tokens)):
            for seg in seg_variants(tokens[i:k + 1]):
                budget[0] -= 1
                if budget[0] <= 0:
                    return found
                child = os.path.join(base, seg)
                if os.path.isdir(child):
                    found.extend(build(k + 1, child))
            if len(found) > 1:
                return found          # ambiguous -- bail early
        return found

    hits = build(0, "/")
    if budget[0] <= 0:
        return None
    return hits[0] if len(hits) == 1 else None


def _cwd_from_transcript(sample_file, slug):
    """The exact repo path, read from the transcript's own `cwd` — no reversal
    guessing. Only trusted when it exists and round-trips to this slug."""
    if not sample_file:
        return None
    try:
        with open(sample_file, errors="replace") as fh:
            for _ in range(20):
                line = fh.readline()
                if not line:
                    break
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                cwd = rec.get("cwd")
                if cwd and os.path.isdir(cwd) and _slug_for_path(cwd) == slug:
                    return cwd
    except OSError:
        pass
    return None


def _repo_path_for_slug(slug, sample_file=None):
    """Prefer the transcript's own `cwd` (exact, unambiguous, fast); fall back to
    the bounded slug-reversal rule only when the cwd is unusable."""
    return _cwd_from_transcript(sample_file, slug) or _path_for_slug(slug)


# Throwaway trees that carry a .flux/flux.toml but are not adopted projects:
# benchmark fixture clones and anything under a temp root. Kept out of the fleet.
_LEDGER_EXCLUDE_PARTS = (".flux-bench", "bench-runs")
_LEDGER_TMP_ROOTS = ("/private/tmp/", "/private/var/folders/", "/tmp/", "/var/folders/")


def _is_adopting_repo(path):
    if not path or not os.path.isfile(os.path.join(path, ".flux", "flux.toml")):
        return False
    # FLUX_LEDGER_ALLOW_TMP=1 lets tests fabricate a fleet under a temp root; off by
    # default, invisible in production (real fleets never live under /tmp).
    if os.environ.get("FLUX_LEDGER_ALLOW_TMP") != "1":
        if any(root in path + "/" for root in _LEDGER_TMP_ROOTS):
            return False
    parts = set(path.split(os.sep))
    return not any(p in parts for p in _LEDGER_EXCLUDE_PARTS)


def _scan_session(path, check_command=""):
    """One transcript -> one row dict. Dedupe requests on message.id; never mix
    sidechain (subagent) traffic into main-thread context; count skill invocations
    on both the slash path and the Skill tool path."""
    reqs, order = {}, []
    pending = {}                 # tool_use_id -> tool name
    tool_names = {}
    read_paths = {}
    bash_bytes = 0
    first_edit_req = None
    n_req = 0
    flux_sub = {}
    raw_gate = 0
    help_reads = 0               # `flux --help` + skill-file reads out of the cache
    skills = {}
    state_set = handoff_call = False
    prime_fired = False
    first_ts = last_ts = None
    try:
        fh = open(path, errors="replace")
    except OSError:
        return None
    with fh:
        for line in fh:
            try:
                rec = json.loads(line)
            except ValueError:
                continue
            typ = rec.get("type")
            stamp = rec.get("timestamp")
            if stamp:
                first_ts = first_ts or stamp
                last_ts = stamp
            if typ == "attachment":
                att = rec.get("attachment", {})
                if (att.get("type") == "hook_success"
                        and str(att.get("hookName", "")).startswith("SessionStart")
                        and "flux prime" in (att.get("content") or "")):
                    prime_fired = True
                continue
            if typ == "user":
                msg = rec.get("message", {})
                content = msg.get("content")
                if isinstance(content, str):
                    if not rec.get("isMeta") and not rec.get("isSidechain"):
                        hit = _LEDGER_CMDNAME_RE.search(content)
                        if hit:
                            skills[hit.group(1)] = skills.get(hit.group(1), 0) + 1
                elif isinstance(content, list):
                    for blk in content:
                        btype = blk.get("type")
                        if btype == "tool_result":
                            name = pending.get(blk.get("tool_use_id"), "?")
                            body = blk.get("content")
                            text = body if isinstance(body, str) else "".join(
                                x.get("text", "") for x in body if isinstance(x, dict))
                            if name == "Bash":
                                bash_bytes += len(text)
                        elif (btype == "text" and not rec.get("isSidechain")
                              and not rec.get("isMeta")):
                            hit = _LEDGER_CMDNAME_RE.search(blk.get("text", ""))
                            if hit:
                                skills[hit.group(1)] = skills.get(hit.group(1), 0) + 1
            elif typ == "assistant":
                msg = rec.get("message", {})
                mid = msg.get("id")
                usage = msg.get("usage") or {}
                sidechain = bool(rec.get("isSidechain"))
                err = str(rec.get("api_error_status")
                          or msg.get("api_error_status") or "")
                if mid and mid not in reqs:
                    reqs[mid] = dict(
                        model=msg.get("model"), sidechain=sidechain,
                        inp=usage.get("input_tokens", 0),
                        cw=usage.get("cache_creation_input_tokens", 0),
                        cr=usage.get("cache_read_input_tokens", 0),
                        out=usage.get("output_tokens", 0),
                        errored=err in RETRYABLE_API_STATUSES)
                    order.append(mid)
                    if not sidechain:
                        n_req += 1
                for blk in msg.get("content") or []:
                    if blk.get("type") != "tool_use":
                        continue
                    name = blk.get("name")
                    inp = blk.get("input") or {}
                    tool_names[name] = tool_names.get(name, 0) + 1
                    pending[blk.get("id")] = name
                    if name == "Read" and not sidechain:
                        fp = inp.get("file_path", "")
                        read_paths[fp] = read_paths.get(fp, 0) + 1
                        if _PLUGIN_SKILL_MARK in fp:
                            help_reads += 1
                    elif name == "Skill":
                        key = "Skill:" + str(inp.get("skill"))
                        skills[key] = skills.get(key, 0) + 1
                    elif (name in ("Edit", "Write", "MultiEdit", "NotebookEdit")
                          and not sidechain and first_edit_req is None):
                        first_edit_req = n_req
                    elif name == "Bash":
                        cmd = inp.get("command", "")
                        sub = _LEDGER_SUB_RE.search(cmd)
                        if sub:
                            key = sub.group(1)
                            flux_sub[key] = flux_sub.get(key, 0) + 1
                            if key in ("--help", "-h"):
                                help_reads += 1
                            if key == "handoff":
                                handoff_call = True
                            if _LEDGER_STATE_SET_RE.search(cmd):
                                state_set = True
                        elif (_LEDGER_RAW_RE.search(cmd)
                              and not _LEDGER_NONEXEC_RE.match(cmd)):
                            raw_gate += 1
                        if _PLUGIN_SKILL_MARK in cmd and (".md" in cmd or "SKILL" in cmd):
                            help_reads += 1
    main = [reqs[i] for i in order if not reqs[i]["sidechain"]]
    ctx = [x["inp"] + x["cw"] + x["cr"] for x in main]
    cost = sum(_ledger_price(x["model"], x["inp"], x["cw"], x["cr"], x["out"])
               for x in reqs.values())
    cw_cost = sum(_ledger_price(x["model"], 0, x["cw"], 0, 0) for x in reqs.values())
    rereads = sum(v - 1 for v in read_paths.values() if v > 1)
    void = (not main) or all(x["errored"] for x in main)
    wrapped = (state_set or handoff_call
               or "/flux:wrap" in skills or "Skill:flux:wrap" in skills)
    return dict(
        id=os.path.basename(path)[:8], start=(first_ts or "")[:16],
        end=(last_ts or "")[:16], requests=len(main), void=void,
        ctx_p50=int(_median(ctx)) if ctx else 0,
        cost=cost, cw_share=round(cw_cost / cost, 2) if cost else 0.0,
        rereads=rereads, bash_bytes=bash_bytes, first_edit_req=first_edit_req,
        flux_check=flux_sub.get("check", 0) + flux_sub.get("run", 0),
        raw_gate=raw_gate, help_reads=help_reads, wrapped=wrapped, prime=prime_fired)


def _ledger_sessions(slug_dir, since):
    """Every transcript in a slug dir with a start >= since, scanned. Skips the
    tiny stubs the reference analyzer skipped (< 5 KB = no real turn)."""
    rows = []
    check_command = ""
    for path in sorted(glob_jsonl(slug_dir)):
        try:
            if os.path.getsize(path) < 5000:
                continue
        except OSError:
            continue
        row = _scan_session(path, check_command)
        if row and row["start"] >= since:
            rows.append(row)
    rows.sort(key=lambda r: r["start"])
    return rows


def glob_jsonl(slug_dir):
    try:
        return [os.path.join(slug_dir, f) for f in os.listdir(slug_dir)
                if f.endswith(".jsonl")]
    except OSError:
        return []


def _aggregate(sessions):
    """Fold substantive sessions into one row of the targets table."""
    n = len(sessions)
    edits = [s["first_edit_req"] for s in sessions if s["first_edit_req"] is not None]
    return dict(
        sessions=n,
        ctx_p50=int(_median([s["ctx_p50"] for s in sessions])),
        cw_share=_median([s["cw_share"] for s in sessions]),
        over_cap=sum(1 for s in sessions if s["requests"] > LEDGER_REQ_CAP),
        rereads=_median([s["rereads"] for s in sessions]),
        bash_bytes=int(_median([s["bash_bytes"] for s in sessions])),
        first_edit=int(_median(edits)) if edits else None,
        wrapped=sum(1 for s in sessions if s["wrapped"]),
        raw_gate=sum(s["raw_gate"] for s in sessions),
        flux_check=sum(s["flux_check"] for s in sessions),
        help_reads=sum(s["help_reads"] for s in sessions),
        dollars=sum(s["cost"] for s in sessions),
        per_session=_median([s["cost"] for s in sessions]),
    )


def _fmt_k(n):
    if n >= 1000:
        return "%.0fk" % (n / 1000.0)
    return str(int(n))


_LEDGER_COHORT_W = 14
_LEDGER_HEADER = ("%-14s %4s %8s %5s %5s %5s %7s %6s %7s %11s %6s %7s %6s"
                  % ("cohort", "sess", "ctx_p50", "cw%", ">150", "rerd", "bash",
                     "->edit", "wrap", "gate r/flx", "reads", "$/sess", "est$"))


def _ledger_row(label, agg):
    if len(label) > _LEDGER_COHORT_W:
        label = label[:_LEDGER_COHORT_W - 1] + "…"
    return ("%-14s %4d %8s %4.0f%% %5d %5s %7s %6s %5d/%-2d %5d/%-4d %6d %7.1f %6.0f"
            % (label, agg["sessions"], _fmt_k(agg["ctx_p50"]),
               agg["cw_share"] * 100, agg["over_cap"], _fmt_k(agg["rereads"]),
               _fmt_k(agg["bash_bytes"]),
               ("-" if agg["first_edit"] is None else str(agg["first_edit"])),
               agg["wrapped"], agg["sessions"], agg["raw_gate"], agg["flux_check"],
               agg["help_reads"], agg["per_session"], agg["dollars"]))


def _is_flux_repo(path):
    manifest = os.path.join(path, ".claude-plugin", "plugin.json")
    try:
        with open(manifest, encoding="utf-8") as fh:
            return json.load(fh).get("name") == "flux"
    except (OSError, ValueError):
        return False


def _fit_to_budget(header_lines, rows, footer_lines, budget):
    """Render header + rows + footer; if over budget, drop the oldest rows (rows
    are newest-last) and mark how many went, so the output never exceeds the cap."""
    def render(rs, elided):
        body = list(header_lines) + rs[:]
        if elided:
            body.append("... %d rows elided (oldest cycles dropped for budget)" % elided)
        body += footer_lines
        return "\n".join(body)

    elided = 0
    keep = rows[:]
    while keep and len(render(keep, elided).encode("utf-8")) > budget:
        keep = keep[1:]
        elided += 1
    text = render(keep, elided)
    # Last resort: rows all dropped and header/footer still overflow -> hard clip.
    if len(text.encode("utf-8")) > budget:
        text = clip(text, budget)
    return text


def _ledger_scope(args):
    since = FLUX_V2_EPOCH
    fleet = as_json = verdict = False
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--since" and i + 1 < len(args):
            since = args[i + 1]
            i += 2
        elif a == "--fleet":
            fleet = True
            i += 1
        elif a == "--json":
            as_json = True
            i += 1
        elif a == "--verdict":
            verdict = True
            i += 1
        else:
            i += 1
    return since, fleet, as_json, verdict


def cmd_ledger(args):
    since, fleet, as_json, verdict = _ledger_scope(args)
    root = repo_root()

    # The verdict is the FIRST branch after arg-parse — before `if fleet` (or
    # `--verdict --fleet` would silently fall to the fleet table) and before the
    # config check. `--verdict` is text-only; it ignores `--json` (nothing reads a
    # JSON verdict yet).
    if verdict:
        return _ledger_verdict(root, since)

    if fleet:
        return _ledger_fleet(since, as_json)

    if read_config(root) is None:
        print("flux ledger: no .flux/ here — nothing to measure")
        return 0

    slug_dir = os.path.join(PROJECTS_DIR, _slug_for_path(root))
    sessions = _ledger_sessions(slug_dir, since)
    if as_json:
        json.dump(sessions, sys.stdout, indent=2)
        sys.stdout.write("\n")
        return 0

    sub = [s for s in sessions if s["requests"] >= LEDGER_SUBSTANTIVE_MIN and not s["void"]]
    voided = sum(1 for s in sessions if s["void"])
    minor = len(sessions) - len(sub) - voided

    header = [
        "flux ledger — %s · since %s · est $ API-equivalent (subscription proxy)"
        % (os.path.basename(root), since),
        _LEDGER_HEADER,
    ]
    rows = []
    for idx in range(0, len(sub), LEDGER_CYCLE):
        chunk = sub[idx:idx + LEDGER_CYCLE]
        partial = len(chunk) < LEDGER_CYCLE
        label = "cycle %d%s" % (idx // LEDGER_CYCLE + 1, "·part" if partial else "")
        rows.append(_ledger_row(label, _aggregate(chunk)))
    footer = []
    if sub:
        footer.append(_ledger_row("TOTAL", _aggregate(sub)))
    footer.append("%d substantive · %d voided · %d minor (<%d req)"
                  % (len(sub), voided, minor, LEDGER_SUBSTANTIVE_MIN))
    budget = state_budget_bytes(read_config(root))
    print(_fit_to_budget(header, rows, footer, budget))
    return 0


def _fleet_scan(since):
    """Every adopting repo's substantive sessions, one entry each:
    [(name, path, is_flux, sub_sessions), …]. The single pooled source both
    `_ledger_fleet` (the table) and the verdict (fleet-scoped claims, meta-tax)
    read — so there is never a second definition of the fleet. Repos with no
    substantive session drop out, exactly as the table always did."""
    repos = []                   # (name, path, is_flux, sub_sessions)
    try:
        slugs = sorted(os.listdir(PROJECTS_DIR))
    except OSError:
        slugs = []
    for slug in slugs:
        slug_dir = os.path.join(PROJECTS_DIR, slug)
        if not os.path.isdir(slug_dir):
            continue
        sample = next(iter(sorted(glob_jsonl(slug_dir))), None)
        path = _repo_path_for_slug(slug, sample)
        if not _is_adopting_repo(path):
            continue
        sessions = _ledger_sessions(slug_dir, since)
        sub = [s for s in sessions
               if s["requests"] >= LEDGER_SUBSTANTIVE_MIN and not s["void"]]
        if not sub:
            continue
        repos.append((os.path.basename(path), path, _is_flux_repo(path), sub))
    return repos


def _ledger_fleet(since, as_json):
    root = repo_root()
    repos = _fleet_scan(since)

    if as_json:
        json.dump({name: _aggregate(sub) for name, _p, _f, sub in repos},
                  sys.stdout, indent=2)
        sys.stdout.write("\n")
        return 0

    if not repos:
        print("flux ledger --fleet: no adopting repos found under %s" % PROJECTS_DIR)
        return 0

    repos.sort(key=lambda r: r[3][-1]["start"])   # oldest activity first
    header = [
        "flux ledger --fleet · since %s · est $ API-equivalent (subscription proxy)"
        % since,
        _LEDGER_HEADER,
    ]
    rows = [_ledger_row(name, _aggregate(sub)) for name, _p, is_flux, sub in repos]

    flux_dollars = sum(_aggregate(sub)["dollars"] for _n, _p, is_flux, sub in repos if is_flux)
    adopt_dollars = sum(_aggregate(sub)["dollars"] for _n, _p, is_flux, sub in repos if not is_flux)
    footer = []
    if flux_dollars:
        ratio = (flux_dollars / adopt_dollars) if adopt_dollars else float("inf")
        footer.append("meta-tax: flux $%.0f / adopting $%.0f = %s"
                      % (flux_dollars, adopt_dollars,
                         ("%.2fx" % ratio) if adopt_dollars else "n/a (no adopting spend)"))
    budget = state_budget_bytes(read_config(root)) if read_config(root) else (
        DEFAULT_STATE_BUDGET_TOKENS * BYTES_PER_TOKEN)
    print(_fit_to_budget(header, rows, footer, budget))
    return 0

# ------------------------------------------------------------------- claims
#
# ADR 0003's loop closer: attribution becomes *data*, not a session's memory.
# Every feature's claim is a record in .flux/claims.jsonl; `flux ledger --verdict`
# scores each open claim against the cycles that postdate it (moved / unmoved N),
# reusing the ledger's own chunking and meta-tax — never a second definition of
# "substantive" or "cycle". A flux-repo-only prime line says when a cycle has
# closed so the next loop session reads the verdict before it changes anything.

CLAIMS_LOG_NAME = "claims.jsonl"

# The vocabulary a claim's `metric` may name: every raw key `_aggregate` produces
# (bin/flux _aggregate) plus two derived ratios the read-out states as fractions.
# `sessions` is a denominator, not a claimable target, so it is deliberately out.
_CLAIM_METRICS = frozenset({
    "ctx_p50", "cw_share", "over_cap", "rereads", "bash_bytes", "first_edit",
    "wrapped", "raw_gate", "flux_check", "help_reads", "dollars", "per_session",
    "wrap_coverage", "meta_tax",
})

# `bar` is an explicit <op><number>: direction is per-metric (ctx/meta-tax lower is
# better, wrap coverage higher, over_cap/help_reads want ==0), so it cannot be
# implied. `<=`/`>=` sit before `<`/`>` in the alternation so the two-char ops win.
_CLAIM_BAR_RE = re.compile(r"^(==|!=|<=|>=|<|>)(-?\d+(?:\.\d+)?)$")
_CLAIM_OPS = {"==": operator.eq, "!=": operator.ne, "<": operator.lt,
              "<=": operator.le, ">": operator.gt, ">=": operator.ge}


def _parse_bar(bar):
    """'<op><number>' -> (op_str, threshold_float), or None if unparseable."""
    m = _CLAIM_BAR_RE.match(bar or "")
    if not m:
        return None
    return m.group(1), float(m.group(2))


def claims_path(root):
    return os.path.join(flux_dir(root), CLAIMS_LOG_NAME)


def read_claims(root):
    """Open claims in file order. Reuses read_log's tolerant line loop (skip any
    line not starting '{', skip anything unparseable) but keeps its own record
    shape — a dict carrying both `feature` and `metric`, not the state log's `k`."""
    records = []
    try:
        with open(claims_path(root), encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line.startswith("{"):
                    continue
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                if (isinstance(rec, dict) and isinstance(rec.get("feature"), str)
                        and isinstance(rec.get("metric"), str)):
                    records.append(rec)
    except OSError:
        return []
    return records


def _claim_cycles(claim):
    try:
        return int(claim.get("cycles", 2))
    except (TypeError, ValueError):
        return 2


def cmd_claim(args):
    """`flux claim add <feature> <metric> <bar> [--scope S] [--cycles N]`.

    Append-only: no close/list/edit (ADR 0003 keeps claim retirement a user+queue
    decision). Re-adding the same feature+metric warns (it resets the eligibility
    clock) but still appends — the store's integrity is that it is never rewritten."""
    if not args or args[0] != "add":
        print("flux claim: usage: flux claim add <feature> <metric> <bar> "
              "[--scope repo|fleet|<name>] [--cycles N]", file=sys.stderr)
        return 2
    scope, cycles, pos = "repo", 2, []
    i = 1
    while i < len(args):
        a = args[i]
        if a == "--scope" and i + 1 < len(args):
            scope = args[i + 1]
            i += 2
        elif a == "--cycles" and i + 1 < len(args):
            try:
                cycles = int(args[i + 1])
            except ValueError:
                print("flux claim: --cycles must be an integer", file=sys.stderr)
                return 2
            i += 2
        else:
            pos.append(a)
            i += 1
    if len(pos) != 3:
        print("flux claim: add takes <feature> <metric> <bar>", file=sys.stderr)
        return 2
    feature, metric, bar = pos
    if metric not in _CLAIM_METRICS:
        print("flux claim: unknown metric %r — one of %s"
              % (metric, ", ".join(sorted(_CLAIM_METRICS))), file=sys.stderr)
        return 2
    if _parse_bar(bar) is None:
        print("flux claim: unparseable bar %r — need <op><number>, "
              "op in == != < <= > >=" % bar, file=sys.stderr)
        return 2
    root = repo_root()
    for c in read_claims(root):
        if c.get("feature") == feature and c.get("metric") == metric:
            print("claim add: %s/%s already open — appending supersedes its clock"
                  % (feature, metric), file=sys.stderr)
            break
    rec = {"ts": now_iso(), "feature": feature, "metric": metric,
           "bar": bar, "scope": scope, "cycles": cycles}
    path = claims_path(root)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "a", encoding="utf-8") as f:
        f.write(json.dumps(rec, ensure_ascii=False) + "\n")
    print("claim added: %s %s %s [%s, cycles=%d]" % (feature, metric, bar, scope, cycles))
    return 0


def _cycle_count(root, cfg, ack_ts):
    """Fleet substantive sessions started after ack_ts, cached in
    .flux/cache/cycle.json. Recompute (a full fleet scan — too heavy for every
    SessionStart) only when the cache is missing, keyed to a different ack, or older
    than the cycle_refresh_hours freshness window."""
    hours = _guard_cfg(cfg, "cycle_refresh_hours", 6)
    cache = _read_cache_json(root, "cycle.json")
    now = time.time()
    if (cache.get("ack") == ack_ts and isinstance(cache.get("n"), int)
            and isinstance(cache.get("computed_at"), (int, float))
            and now - cache["computed_at"] < hours * 3600):
        return cache["n"]
    ack_min = ack_ts[:16]
    n = sum(1 for _name, _p, _f, sub in _fleet_scan(FLUX_V2_EPOCH)
            for s in sub if s["start"] > ack_min)
    _write_cache_json(root, "cycle.json", {"ack": ack_ts, "n": n, "computed_at": now})
    return n


def _append_cycle_line(root, cfg, lines):
    """Flux-repo-only (ADR 0003): append one line to the prime pack when a cycle has
    closed since the newest claim ts — claims.jsonl *is* the ack clock, no separate
    marker. Owns its try/except: cmd_prime's blanket `except: return 0` would blank
    the WHOLE pack on an unguarded raise here, not just this line (A2)."""
    try:
        if not _is_flux_repo(root):
            return
        claims = read_claims(root)
        if not claims:
            return
        newest = max((str(c.get("ts", "")) for c in claims), default="")
        if not newest:
            return
        n = _cycle_count(root, cfg, newest)
        if n >= LEDGER_CYCLE:
            lines.append(
                "cycle closed — %d substantive sessions since %s; read "
                "`flux ledger --verdict`, then `flux claim add …` before the next change."
                % (n, newest[:10]))
    except Exception:
        return


def _fmt_val(v):
    if v is None:
        return "n/a"
    if isinstance(v, float):
        return "%.2f" % v
    return str(v)


def _chunk_metric(metric, chunk):
    """One claim's metric over one cycle chunk. Raw metrics come straight from
    `_aggregate` (reused, never re-derived); `wrap_coverage` is the wrapped/sessions
    ratio the read-out states. `first_edit` is None for an edit-free chunk — the
    caller skips such chunks (no signal), it is not a miss."""
    agg = _aggregate(chunk)
    if metric == "wrap_coverage":
        return agg["wrapped"] / agg["sessions"] if agg["sessions"] else None
    return agg.get(metric)


def _verdict_sessions(root, since, scope):
    """The substantive sessions a claim's scope is judged over — the ledger's own
    `sub` filter, never a second definition. `repo` = this slug; `fleet` = every
    adopting repo pooled; a bare name = that repo."""
    if scope == "fleet":
        return [s for _n, _p, _f, sub in _fleet_scan(since) for s in sub]
    if scope == "repo":
        slug_dir = os.path.join(PROJECTS_DIR, _slug_for_path(root))
        sessions = _ledger_sessions(slug_dir, since)
        return [s for s in sessions
                if s["requests"] >= LEDGER_SUBSTANTIVE_MIN and not s["void"]]
    return [s for name, _p, _f, sub in _fleet_scan(since) if name == scope
            for s in sub]


def _verdict_general(claim, op, threshold, sub):
    """Per-cycle verdict for every metric but meta_tax. Eligible = sessions whose
    start (minute-normalized) is strictly after the claim ts; chunk by LEDGER_CYCLE;
    only complete chunks count. State: pending (<1 valued cycle) / moved (latest
    complete cycle meets the bar) / unmoved K (K consecutive trailing complete
    cycles miss, capped at the claim's patience)."""
    metric = claim["metric"]
    scope = claim.get("scope", "repo")
    prefix = "%s %s %s [%s]" % (claim.get("feature", "?"), metric,
                                claim.get("bar", ""), scope)
    cycles = _claim_cycles(claim)
    claim_ts = str(claim.get("ts", ""))[:16]
    elig = sorted((s for s in sub if s["start"] > claim_ts), key=lambda s: s["start"])
    chunks = [elig[i:i + LEDGER_CYCLE] for i in range(0, len(elig), LEDGER_CYCLE)]
    complete = [ch for ch in chunks if len(ch) == LEDGER_CYCLE]
    if not complete:
        return "%s — pending (%d eligible session%s, <1 cycle)" % (
            prefix, len(elig), "" if len(elig) == 1 else "s")
    values = [_chunk_metric(metric, ch) for ch in complete]
    if all(v is None for v in values):        # e.g. first_edit over edit-free cycles
        return "%s — pending (no signal in %d cycle%s)" % (
            prefix, len(complete), "" if len(complete) == 1 else "s")
    latest = next(v for v in reversed(values) if v is not None)
    if op(latest, threshold):
        state = "moved"
    else:
        missed = 0
        for v in reversed(values):
            if v is None:
                continue
            if op(v, threshold):
                break
            missed += 1
        state = "unmoved %d" % min(missed, cycles)
    return "%s — %s (latest=%s, %d cycles)" % (
        prefix, state, _fmt_val(latest), len(complete))


def _verdict_meta_tax(since, claim, op, threshold):
    """meta_tax is a fleet window ratio (flux$ / adopting$), NOT a per-chunk metric:
    a session carries no repo tag, so the ratio can only be summed across the whole
    eligible window via `_fleet_scan`'s is_flux split. Patience is the window
    spanning ≥ cycles×LEDGER_CYCLE eligible sessions. Divergence from the per-cycle
    model is stated in the line so it is not read as a bug."""
    scope = claim.get("scope", "fleet")
    prefix = "%s meta_tax %s [%s]" % (claim.get("feature", "?"),
                                      claim.get("bar", ""), scope)
    cycles = _claim_cycles(claim)
    claim_ts = str(claim.get("ts", ""))[:16]
    scan = _fleet_scan(since)
    n_elig = 0
    flux_d = adopt_d = 0.0
    for _n, _p, is_flux, sub in scan:
        esub = [s for s in sub if s["start"] > claim_ts]
        n_elig += len(esub)
        if not esub:
            continue
        d = _aggregate(esub)["dollars"]
        if is_flux:
            flux_d += d
        else:
            adopt_d += d
    if n_elig < LEDGER_CYCLE:
        return "%s — pending (%d eligible fleet session%s, <1 cycle)" % (
            prefix, n_elig, "" if n_elig == 1 else "s")
    if adopt_d <= 0:
        return "%s — pending (n/a — no adopting spend)" % prefix
    ratio = flux_d / adopt_d
    if op(ratio, threshold):
        state = "moved"
    else:
        state = "unmoved %d" % (cycles if n_elig >= cycles * LEDGER_CYCLE else 1)
    return "%s — %s (ratio=%.2f, window sum over %d sessions; window-ratio, not per-cycle)" % (
        prefix, state, ratio, n_elig)


def _verdict_line(root, since, claim):
    bar = claim.get("bar", "")
    parsed = _parse_bar(bar)
    prefix = "%s %s %s [%s]" % (claim.get("feature", "?"), claim.get("metric", "?"),
                                bar, claim.get("scope", "repo"))
    if parsed is None:
        return "%s — invalid bar (skip)" % prefix
    op_str, threshold = parsed
    op = _CLAIM_OPS[op_str]
    if claim.get("metric") == "meta_tax":
        return _verdict_meta_tax(since, claim, op, threshold)
    sub = _verdict_sessions(root, since, claim.get("scope", "repo"))
    return _verdict_general(claim, op, threshold, sub)


def _ledger_verdict(root, since):
    """`flux ledger --verdict` — one budgeted line per open claim, scoring it
    against the cycles that postdate it. Text only (ignores --json)."""
    claims = read_claims(root)
    if not claims:
        print("flux ledger --verdict: no claims yet — `flux claim add …`")
        return 0
    header = ["flux ledger --verdict — %s · one line per open claim"
              % os.path.basename(root)]
    rows = [_verdict_line(root, since, c) for c in claims]
    cfg = read_config(root)
    budget = state_budget_bytes(cfg) if cfg else DEFAULT_STATE_BUDGET_TOKENS * BYTES_PER_TOKEN
    print(_fit_to_budget(header, rows, [], budget))
    return 0

# ------------------------------------------------------------------------ main

COMMANDS = {
    "init": cmd_init,
    "prime": cmd_prime,
    "state": cmd_state,
    "check": cmd_check,
    "handoff": cmd_handoff,
    "run": cmd_run,
    "ledger": cmd_ledger,
    "log": cmd_log,
    "guard": cmd_guard,
    "seal": cmd_seal,
    "claim": cmd_claim,
    "task": cmd_task,
}

def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    handler = COMMANDS.get(argv[1])
    if handler is None:
        print("flux: unknown command %r\n" % argv[1], file=sys.stderr)
        print(__doc__.strip(), file=sys.stderr)
        return 2
    return handler(argv[2:])

if __name__ == "__main__":
    sys.exit(main(sys.argv))
