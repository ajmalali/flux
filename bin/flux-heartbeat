#!/usr/bin/env bash
#
# flux-heartbeat — Stop hook: stamp .flux/session.json at the end of every turn.
#
# The Stop hook fires whether or not a skill ran, so this is what keeps session
# state fresh when the user works raw. Contract (ADR-0001, fail-open): under
# 500ms, silent on both streams, and always exit 0 — exit 2 would force the
# model to keep going, which a heartbeat must never do.
#
# Writes ONLY .flux/session.json (machine state, gitignored). Never touches
# tickets or durable docs. The write itself is session_stamp in flux-common,
# shared with prime (ADR-0005): atomic, and merging rather than clobbering, so
# `last_synced_commit` is carried over untouched — only /sync advances it.
#
# stdin:  Stop hook JSON — {session_id, transcript_path, cwd, hook_event_name,
#         prompt_id, permission_mode, stop_hook_active, last_assistant_message,
#         background_tasks, session_crons}. No token or context figure: the
#         count comes from the transcript that transcript_path names (FLX-63o).
# stdout: nothing.

set -u

# shellcheck source=/dev/null
. "$(dirname "${BASH_SOURCE[0]}")/flux-common" 2>/dev/null || exit 0

# ------------------------------------------------------------------- main ---

main() {
  local stdin_json cwd root file
  stdin_json=$(cat 2>/dev/null)
  cwd=$(hook_cwd "$stdin_json")
  root=$(repo_root "$cwd")
  file="$root/.flux/session.json"

  local branch head_sha dirty drift claimed last_done synced tokens now
  branch=$(git -C "$root" symbolic-ref --quiet --short HEAD 2>/dev/null)
  if [ -z "$branch" ] && git -C "$root" rev-parse --verify HEAD >/dev/null 2>&1; then
    branch="detached"
  fi
  head_sha=$(git -C "$root" rev-parse --short HEAD 2>/dev/null)
  dirty=$(git -C "$root" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
  [ -n "$dirty" ] || dirty=0

  # Recounted every turn, not just at session start: commits happen mid-session,
  # and the statusline can only show what the last stamp left it (FLX-21).
  drift=$(drift_count "$root" 2>/dev/null)

  claimed=$(first_id "$(store_claimed "$root" "$(basename "$root")" 2>/dev/null)")

  # What the statusline names when nothing is claimed: the last ticket finished,
  # not the next one up (ADR-0006). Resolved here rather than there on purpose —
  # this is the only hook with the budget for a store verb, and the statusline
  # must stay free of them.
  last_done=$(first_id "$(store_done "$root" 2>/dev/null)")

  # Preserved across turns; seeded from HEAD the first time we see this repo.
  # Named explicitly rather than left to the merge because of that seeding.
  synced=$(session_field "$file" last_synced_commit)
  [ -n "$synced" ] || synced=$(git -C "$root" rev-parse HEAD 2>/dev/null)

  # The one number in here the model cannot see for itself. The statusline reads
  # it live off its own stdin and shows it to the human; a skill working to a
  # token budget has no such channel, so the count is resolved here — off the
  # transcript, since the event does not carry it — and left where the skill can
  # read it (FLX-63o). Empty stamps null, never 0: not knowing is its own answer.
  tokens=$(context_tokens "$(hook_field "$stdin_json" transcript_path)" 2>/dev/null)

  now=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)

  session_stamp "$root" \
    last_turn_at "$now" \
    branch "$branch" \
    head_sha "$head_sha" \
    dirty_files "$dirty" \
    drift_commits "$drift" \
    context_tokens "$tokens" \
    claimed_ticket "$claimed" \
    last_done_ticket "$last_done" \
    last_synced_commit "$synced"
  return 0
}

main 2>/dev/null
exit 0
