#!/usr/bin/env bash
#
# flux-heartbeat — Stop hook: stamp .flux/session.json at the end of every turn.
#
# The Stop hook fires whether or not a skill ran, so this is what keeps session
# state fresh when the user works raw. Contract (ADR-0001, fail-open): under
# 500ms, silent on both streams, and always exit 0 — exit 2 would force the
# model to keep going, which a heartbeat must never do.
#
# Writes ONLY .flux/session.json (machine state, gitignored). Never touches
# tickets or durable docs. The write is atomic: temp file in .flux/, then mv.
# `last_synced_commit` is carried over untouched — only /sync advances it.
#
# stdin:  Stop hook JSON — {session_id, transcript_path, cwd, hook_event_name, ...}
# stdout: nothing.

set -u

# shellcheck source=/dev/null
. "$(dirname "${BASH_SOURCE[0]}")/flux-common" 2>/dev/null || exit 0

TMPFILE=""
trap '[ -n "$TMPFILE" ] && rm -f "$TMPFILE"' EXIT

# ---------------------------------------------------------------- helpers ---

# A bare string as a JSON string. Git refnames and ticket ids cannot contain
# control characters, so escaping backslash and quote is enough.
json_str() {
  local s="$1"
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  printf '"%s"' "$s"
}

# Same, but an empty value becomes JSON null rather than "".
json_or_null() {
  if [ -z "$1" ]; then printf 'null'; else json_str "$1"; fi
}

# Top-level string field of a previous session.json. jq when available; a sed
# read of our own fixed layout otherwise, so a missing jq is not a data loss.
prev_field() {
  local file="$1" key="$2" val=""
  [ -f "$file" ] || return 0
  if have jq; then
    val=$(jq -r --arg k "$key" '.[$k] // empty' "$file" 2>/dev/null)
  fi
  if [ -z "$val" ]; then
    val=$(sed -n "s/.*\"$key\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$file" 2>/dev/null | head -1)
  fi
  printf '%s' "$val"
}

# ------------------------------------------------------------------- main ---

main() {
  local stdin_json cwd root file
  stdin_json=$(cat 2>/dev/null)
  cwd=$(hook_cwd "$stdin_json")
  root=$(repo_root "$cwd")
  file="$root/.flux/session.json"

  local branch head_sha dirty claimed synced now
  branch=$(git -C "$root" symbolic-ref --quiet --short HEAD 2>/dev/null)
  if [ -z "$branch" ] && git -C "$root" rev-parse --verify HEAD >/dev/null 2>&1; then
    branch="detached"
  fi
  head_sha=$(git -C "$root" rev-parse --short HEAD 2>/dev/null)
  dirty=$(git -C "$root" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
  [ -n "$dirty" ] || dirty=0

  claimed=$(store_claimed "$root" "$(basename "$root")" 2>/dev/null | head -1 | cut -f1)

  # Preserved across turns; seeded from HEAD the first time we see this repo.
  synced=$(prev_field "$file" last_synced_commit)
  [ -n "$synced" ] || synced=$(git -C "$root" rev-parse HEAD 2>/dev/null)

  now=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)

  mkdir -p "$root/.flux" 2>/dev/null || return 0
  TMPFILE=$(mktemp "$root/.flux/session.json.XXXXXX" 2>/dev/null) || { TMPFILE=""; return 0; }
  {
    printf '{\n'
    printf '  "last_turn_at": %s,\n' "$(json_or_null "$now")"
    printf '  "branch": %s,\n' "$(json_or_null "$branch")"
    printf '  "head_sha": %s,\n' "$(json_or_null "$head_sha")"
    printf '  "dirty_files": %s,\n' "$dirty"
    printf '  "claimed_ticket": %s,\n' "$(json_or_null "$claimed")"
    printf '  "last_synced_commit": %s\n' "$(json_or_null "$synced")"
    printf '}\n'
  } >"$TMPFILE" 2>/dev/null || return 0

  mv -f "$TMPFILE" "$file" 2>/dev/null && TMPFILE=""
  return 0
}

main 2>/dev/null
exit 0
