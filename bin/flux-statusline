#!/usr/bin/env bash
#
# flux-statusline — statusLine command: one always-visible line of flux state.
#
#   FLX-04-claimed · main · ctx 41% · 83.6k
#   FLX-19-done · main · ctx 41% · 83.6k
#   FLX-19-done · main · ⚠ 2 drift · ctx 41% · 83.6k · /sync
#   FLX-04-claimed · main · ctx 78% · 156k · /pause
#   FLX-04-claimed · main · ctx 36% · 361k · /pause
#   no tickets · main · ctx 41% · 83.6k
#
# Contract (ADR-0001, fail-open): read-only, no network, always exit 0, and
# always exactly one line — a broken statusline must never blank the footer.
#
# Speed matters more here than in the hooks: the statusline re-renders on every
# event, so the budget is 100ms, not 500ms. That rules out git and bd — no store
# verbs, no drift, no frontier (prime's job). The only subprocesses are jq for
# the stdin JSON and jq for .flux/session.json; the branch is read out of
# .git/HEAD with builtins rather than paying for a `git` fork.
#
# stdin:  statusLine JSON — https://code.claude.com/docs/en/statusline
#         .workspace.git_worktree (only inside a linked worktree),
#         .workspace.current_dir, .workspace.project_dir, .cwd,
#         .context_window.used_percentage (may be null early in a session),
#         .context_window.total_input_tokens + .total_output_tokens — what is
#         in the window now, input inclusive of cache reads and writes.
#         There is no general branch field: .worktree.branch exists only in
#         --worktree sessions, so the branch is read from disk instead.
#         .flux/session.json supplies claimed_ticket and last_done_ticket; both
#         are resolved by the hooks, never by this script.
# stdout: <ticket>-<state> · <branch> · ctx <N>% [· <tokens>]

set -u

# shellcheck source=/dev/null
. "$(dirname "${BASH_SOURCE[0]}")/flux-common" 2>/dev/null || exit 0

NO_TICKET='no tickets'
MAX_WALK=40

# When the line starts suggesting /pause. Two marks, whichever comes first:
# an absolute token count, and a share of the window. The share alone is wrong
# on a 1M window — 75% of it is 750k, far past the point where a planning
# session should have deposited and handed off. The count alone is wrong on a
# 200k window, which can never reach it and would go to compaction unwarned.
# Each mark covers the window size the other misreads.
HINT_TOKENS=350000
HINT_CTX_PCT=75

# ---------------------------------------------------------------- helpers ---

# Fields we need from the statusLine JSON, as one tab-separated row:
#   worktree \t current_dir \t project_dir \t context percent \t tokens
# Read with split_row, never `IFS=$'\t' read` — an absent worktree is the common
# case here, and collapsing that empty field would shift every later field left.
parse_stdin() {
  printf '%s' "$1" | jq -r '
    def num: if type == "number" then floor else 0 end;
    [ (.workspace.git_worktree // ""),
      (.workspace.current_dir // .cwd // ""),
      (.workspace.project_dir // ""),
      ((.context_window.used_percentage // 0) | num),
      (((.context_window.total_input_tokens // 0) | num)
        + ((.context_window.total_output_tokens // 0) | num))
    ] | map(tostring) | @tsv
  ' 2>/dev/null
}

# Checked-out branch of $1, read straight out of .git — a `git` fork costs more
# than the whole rest of this script. Handles the linked-worktree case, where
# .git is a file pointing at the real git dir. A detached HEAD renders as a
# short sha. Empty when $1 is not a git checkout, which is the caller's cue to
# fall back to a directory name.
git_branch() {
  local root="$1" line=""
  local gitdir="$root/.git"
  if [ -f "$gitdir" ]; then
    [ -r "$gitdir" ] || return 0
    read -r line <"$gitdir" 2>/dev/null || return 0
    case "$line" in
      'gitdir: '*) gitdir="${line#gitdir: }" ;;
      *) return 0 ;;
    esac
    case "$gitdir" in /*) ;; *) gitdir="$root/$gitdir" ;; esac
  fi
  [ -r "$gitdir/HEAD" ] || return 0
  read -r line <"$gitdir/HEAD" 2>/dev/null || return 0
  case "$line" in
    'ref: refs/heads/'*) printf '%s' "${line#ref: refs/heads/}" ;;
    'ref: '*) printf '%s' "${line#ref: }" ;;
    ?*) printf '%s' "${line:0:7}" ;;
  esac
  return 0
}

# fmt_tokens <var> <n> — token count into <var>: 940, 83.6k, 158k. Integer
# arithmetic and printf -v, no subshell: this runs on every render.
fmt_tokens() {
  local n="$2" tenths
  if [ "$n" -lt 1000 ]; then
    printf -v "$1" '%s' "$n"
  elif [ "$n" -lt 100000 ]; then
    tenths=$(((n + 50) / 100))
    printf -v "$1" '%s.%sk' "$((tenths / 10))" "$((tenths % 10))"
  else
    printf -v "$1" '%sk' "$(((n + 500) / 1000))"
  fi
}

# Nearest ancestor of $1 (inclusive) holding .flux/ or .git — the directory the
# heartbeat writes session state into. Pure parameter expansion: walking up with
# dirname would cost a fork per level. Empty when there is no such ancestor.
find_root() {
  local dir="$1" i=0
  while [ -n "$dir" ] && [ "$i" -lt "$MAX_WALK" ]; do
    if [ -d "$dir/.flux" ] || [ -e "$dir/.git" ]; then
      printf '%s' "$dir"
      return 0
    fi
    dir="${dir%/*}"
    i=$((i + 1))
  done
}

# claimed_ticket \t status \t last_done_ticket \t drift_commits from a
# session.json. `status` is optional: the hooks do not write it today, but a
# verb that wants to show something other than "claimed" can, and this picks it
# up without a change here. The other three are what the hooks resolved from the
# store and from git — reading them is what lets this script report a ticket and
# a drift count while running neither a store verb nor a `git` fork.
read_session() {
  local file="$1" id="" st="" dn="" dr=""
  [ -f "$file" ] || return 0
  if have jq; then
    jq -r '[(.claimed_ticket // ""), (.status // ""), (.last_done_ticket // ""),
            ((.drift_commits // 0) | tostring)] | @tsv' "$file" 2>/dev/null
    return 0
  fi
  id=$(sed_field "$file" claimed_ticket)
  st=$(sed_field "$file" status)
  dn=$(sed_field "$file" last_done_ticket)
  dr=$(sed_field "$file" drift_commits)
  printf '%s\t%s\t%s\t%s\n' "$id" "$st" "$dn" "$dr"
}

# Top-level field of our own fixed session.json layout, for the no-jq case.
# Quoted or bare — the numeric fields are written without quotes. Never sees a
# hand-written file, so a real parser would be overkill.
sed_field() {
  sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\"\{0,1\}\([^\",}]*\)\"\{0,1\}.*/\1/p" \
    "$1" 2>/dev/null | head -1
}

# ------------------------------------------------------------------- main ---

main() {
  local stdin_json="" wt="" cur="" proj="" pct="" tokens=""
  stdin_json=$(cat 2>/dev/null)
  if have jq; then
    split_row "$(parse_stdin "$stdin_json")" wt cur proj pct tokens
  fi

  # Everything below has to survive jq being absent or the JSON being garbage,
  # so each value falls back to something the process already knows.
  [ -n "$cur" ] || cur="$PWD"
  case "$pct" in '' | *[!0-9]*) pct=0 ;; esac
  case "$tokens" in '' | *[!0-9]*) tokens=0 ;; esac

  local root name
  root=$(find_root "$cur")
  [ -n "$root" ] || root=$(find_root "$proj")
  [ -n "$root" ] || root="${proj:-$cur}"

  # Branch first — it is what actually changes under you. The worktree name and
  # the directory are only stand-ins for when there is no branch to read.
  name=$(git_branch "$root")
  [ -n "$name" ] || name="$wt"
  [ -n "$name" ] || name="${root##*/}"
  [ -n "$name" ] || name='?'

  local ticket="" status="" last_done="" drift=""
  split_row "$(read_session "$root/.flux/session.json")" ticket status last_done drift
  case "$drift" in '' | *[!0-9]*) drift=0 ;; esac

  # One segment carries both the ticket and what is happening to it, so there is
  # no second word repeating it. Claimed wins; idle names the last ticket
  # finished rather than a guess at the next one (ADR-0006) — a fact that stays
  # put, where the frontier head moved under the reader.
  local label
  if [ -n "$ticket" ] && [ "$ticket" != "null" ]; then
    [ -n "$status" ] || status="claimed"
    label="$ticket-$status"
  elif [ -n "$last_done" ] && [ "$last_done" != "null" ]; then
    label="$last_done-done"
  else
    label="$NO_TICKET"
  fi

  # Only when there is drift. A warning that is always on the line is a warning
  # nobody reads, and the clean case is the overwhelmingly common one (FLX-21).
  # "drift" does not take a plural here: the count is commits, and the word is
  # the condition they add up to. `⚠ 2 drifts` was tried and read badly.
  local warn=""
  [ "$drift" -gt 0 ] && warn=" · ⚠ $drift drift"

  # At most one verb, and only when there is something to act on — a hint that
  # is always there is furniture, and furniture is not read. Ordered by the cost
  # of doing nothing: a full window loses the session, drift loses only the
  # attribution. Arithmetic on values already in hand, so it costs nothing.
  local hint=""
  if [ "$tokens" -ge "$HINT_TOKENS" ] || [ "$pct" -ge "$HINT_CTX_PCT" ]; then
    hint=' · /pause'
  elif [ "$drift" -gt 0 ]; then
    hint=' · /sync'
  fi

  # No token segment before the first API response: "ctx 0% · 0" is noise.
  if [ "$tokens" -gt 0 ]; then
    local human=""
    fmt_tokens human "$tokens"
    printf '%s · %s%s · ctx %s%% · %s%s\n' "$label" "$name" "$warn" "$pct" "$human" "$hint"
  else
    printf '%s · %s%s · ctx %s%%%s\n' "$label" "$name" "$warn" "$pct" "$hint"
  fi
  return 0
}

main 2>/dev/null
exit 0
