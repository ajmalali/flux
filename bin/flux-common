#!/usr/bin/env bash
#
# flux-common — shared plumbing for the flux hook scripts. Sourced, not run.
#
# Everything here obeys the hook contract (ADR-0001, fail-open): no network, no
# writes outside .flux/session.json, and no path that can make a caller exit
# non-zero. The ticket store is reached only through the store_* verbs (ADR-0002)
# so callers never see beads' schema or the markdown fallback's shape.
#
# Env:
#   FLUX_BD — beads binary to use (default: bd). Point it at a missing path to
#             force the markdown fallback.

BD_BIN="${FLUX_BD:-bd}"

# Ticket ids, as they appear in frontmatter and in commit messages.
#
# Two id shapes, both real: the hand-numbered FLX-09 the markdown store used,
# and the base36 hash beads stamps on anything it creates itself — `bd init`
# says so out loud ("Issues will be named: FLX-<hash>"), and FLX-63o is already
# on this repo's frontier. One body, [0-9a-z]+, covers both.
#
# The prefix is per-repo (`bd init -p <PREFIX>`), so this pattern is what we
# fall back to when the repo has not said what its own is: any all-caps word,
# plus `bd`, the prefix beads defaults to. Broad on purpose and eager as a
# result — a commit body citing ADR-0006 or AC-11 reads as linked here, and this
# repo's bodies cite both. That is why ticket_id_re narrows it wherever the repo
# can name its prefix, and why this is only the fallback.
TICKET_ID_ANY_RE='([A-Z][A-Z0-9]+|bd)-[0-9a-z]+'

# How far back store_done reads for the commit that closed a ticket, and how far
# drift_count reads for commits that name none.
MAX_DONE_SCAN=40
MAX_DRIFT_SCAN=200

# How much of a transcript's tail context_tokens reads. The record it wants is
# the last one, and a whole transcript is unbounded — this caps the read at a
# size that still comfortably contains the final assistant record even when the
# turns before it carried large tool results.
MAX_TRANSCRIPT_TAIL=400000

# ---------------------------------------------------------------- helpers ---

have() { command -v "$1" >/dev/null 2>&1; }

# split_row <row> <var>… — assign the tab-separated fields of <row> to the named
# variables, last variable taking the remainder.
#
# `IFS=$'\t' read -r a b c` cannot do this: tab is IFS whitespace, so a run of
# tabs counts as one separator and an empty field silently shifts every later
# field left — an untiered frontier row would print its title as its tier.
# Parameter expansion only, so splitting a row costs no forks. Fields the row
# does not have become empty.
split_row() {
  local row="$1"
  shift
  while [ "$#" -gt 1 ]; do
    printf -v "$1" '%s' "${row%%$'\t'*}"
    case "$row" in
      *$'\t'*) row="${row#*$'\t'}" ;;
      *) row="" ;;
    esac
    shift
  done
  [ "$#" -eq 1 ] && printf -v "$1" '%s' "$row"
  return 0
}

# hook_field <json> <key> — a top-level field of the event JSON, "" when jq is
# missing, the JSON is unusable, or the field is absent. Every hook event shares
# a handful of these (session_id, transcript_path, cwd, …), so reading one is
# the same job whichever hook is asking.
hook_field() {
  local json="$1" key="$2" val=""
  if have jq && [ -n "$json" ]; then
    val=$(printf '%s' "$json" | jq -r --arg k "$key" '.[$k] // empty' 2>/dev/null)
  fi
  printf '%s' "$val"
}

# The working directory a hook was fired in: .cwd from the event JSON passed as
# $1, falling back to $PWD when jq is missing or the JSON is unusable.
hook_cwd() {
  local cwd=""
  cwd=$(hook_field "$1" cwd)
  [ -n "$cwd" ] && [ -d "$cwd" ] || cwd="$PWD"
  printf '%s' "$cwd"
}

# Repository root containing $1, or $1 itself outside a repo.
repo_root() {
  local cwd="$1" root
  root=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null)
  [ -n "$root" ] && [ -d "$root" ] || root="$cwd"
  printf '%s' "$root"
}

# The id field of the first of a store verb's TSV rows; empty when there are
# none. Parameter expansion only — `head -1 | cut -f1` is two forks for a job
# the shell already has the string for.
first_id() {
  local row="${1%%$'\n'*}"
  printf '%s' "${row%%$'\t'*}"
}

# ticket_id_re <root> — the regex this repo's ticket ids match.
#
# Files only, never a store verb: beads stays out of the hook path (ADR-0002)
# and out of its budget (ADR-0004). Two places a repo can name its own prefix —
# the config key `bd init -p` corresponds to, which bd only writes when it was
# asked for one, then the first id in the JSONL export, tracked here precisely
# so every ticket is readable without beads (CLAUDE.md). Both come out of an
# alphanumeric character class, so neither can carry a regex metacharacter into
# the pattern it builds. A repo that names neither gets TICKET_ID_ANY_RE and its
# wider net.
ticket_id_re() {
  local root="$1" prefix=""
  prefix=$(awk '
    /^[[:space:]]*issue-prefix:/ {
      v = $0
      sub(/^[[:space:]]*issue-prefix:[[:space:]]*/, "", v)
      sub(/#.*$/, "", v)
      gsub(/[^A-Za-z0-9]/, "", v)
      if (v != "") { print v; exit }
    }
  ' "$root/.beads/config.yaml" 2>/dev/null)
  [ -n "$prefix" ] || prefix=$(awk '
    match($0, /"id"[[:space:]]*:[[:space:]]*"[A-Za-z][A-Za-z0-9]*-/) {
      v = substr($0, RSTART, RLENGTH)
      sub(/^.*"/, "", v)
      sub(/-$/, "", v)
      print v
      exit
    }
  ' "$root/.beads/issues.jsonl" 2>/dev/null)

  # `bd` rides along with a named prefix: it is what ids created before the repo
  # had one look like, and they are still in the history.
  case "$prefix" in
    '') printf '%s' "$TICKET_ID_ANY_RE" ;;
    bd) printf 'bd-[0-9a-z]+' ;;
    *) printf '(%s|bd)-[0-9a-z]+' "$prefix" ;;
  esac
}

# --------------------------------------------------------- session state ---
# .flux/session.json is the one file the hooks write: machine state, gitignored,
# and the only thing the statusline reads. Two hooks stamp it — the heartbeat at
# the end of every turn, prime at the start of a session (ADR-0005) — so the
# write lives here once rather than in both.

# A bare string as a JSON string. Ticket ids, refnames and timestamps cannot
# hold control characters, so backslash and quote are the whole escape table.
json_str() {
  local s="$1"
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  printf '"%s"' "$s"
}

# Same, but an empty value becomes JSON null rather than "".
json_or_null() {
  if [ -z "$1" ]; then printf 'null'; else json_str "$1"; fi
}

# The fields we own, in the order they are written. Two are plain numbers, one
# is a number that can also be null; everything else is a string or null.
SESSION_KEYS=(last_turn_at branch head_sha dirty_files drift_commits context_tokens claimed_ticket last_done_ticket last_synced_commit)
SESSION_NUMERIC=" dirty_files drift_commits "

# Numbers where absence is a real answer and 0 would be a lie. A repo with no
# drifted commits genuinely has 0 of them; a session whose token count could not
# be read has not spent zero tokens, it has spent an unknown number — and a
# reader deciding whether to recommend a pause has to be able to tell those
# apart (FLX-63o).
SESSION_NULLABLE_NUMERIC=" context_tokens "

# Fields we used to own and no longer write, as a JSON array. The merge below
# deletes them, so a session.json left by an older install stops carrying a
# stale answer around: `next_ticket` was the frontier head, retired in ADR-0006.
# Preserving unknown fields is for what other verbs write, not for our own past.
SESSION_RETIRED_KEYS='["next_ticket"]'

# session_field <file> <key> — top-level value as text, "" when the file, the
# key or the value is absent. jq when we have it, a sed read of our own fixed
# layout otherwise, so a missing jq costs a field its freshness, never its
# value. The fallback accepts an unquoted value too — the numeric fields are
# written bare — and reads a literal null as absent, which is what it means.
session_field() {
  local file="$1" key="$2" val=""
  [ -f "$file" ] || return 0
  if have jq; then
    val=$(jq -r --arg k "$key" '.[$k] // empty' "$file" 2>/dev/null)
  fi
  if [ -z "$val" ]; then
    val=$(sed -n "s/.*\"$key\"[[:space:]]*:[[:space:]]*\"\{0,1\}\([^\",}]*\)\"\{0,1\}.*/\1/p" \
      "$file" 2>/dev/null | head -1)
    [ "$val" = null ] && val=""
  fi
  printf '%s' "$val"
}

# How many commits since the sync baseline carry no ticket id — work that
# happened outside the harness. Always a number; 0 whenever there is no usable
# baseline, which is also the honest answer before the first /sync.
#
# The baseline is read, never written: only /sync (FLX-14) advances it. Both
# hooks call this — prime to print its sentence, the heartbeat to keep the count
# fresh through a session that commits — and the statusline only ever reads the
# number they leave behind (FLX-04, ADR-0006).
drift_count() {
  local root="$1" base msg re n=0
  base=$(session_field "$root/.flux/session.json" last_synced_commit)
  if [ -n "$base" ] && git -C "$root" cat-file -e "${base}^{commit}" 2>/dev/null; then
    re=$(ticket_id_re "$root")
    while IFS= read -r -d '' msg; do
      [[ $msg =~ $re ]] || n=$((n + 1))
    done < <(git -C "$root" log -z -n "$MAX_DRIFT_SCAN" --format='%s%n%b' "${base}..HEAD" 2>/dev/null)
  fi
  printf '%s' "$n"
}

# context_tokens <transcript_path> — tokens in the model's context window as of
# the last completed turn, or "" when it cannot be known.
#
# This exists because the number is not in the hook event. A Stop event carries
# session_id, transcript_path, cwd, prompt_id, permission_mode, hook_event_name,
# stop_hook_active, last_assistant_message, background_tasks, session_crons —
# and nothing about tokens or the window (FLX-63o, captured and checked, not
# recalled). What it does carry is the path to the transcript, and every
# assistant record there has the `usage` the API returned. Their sum is the same
# quantity the statusline prints from .context_window: input inclusive of cache
# reads and writes, plus output.
#
# Two things it must get right. Sidechain records belong to a subagent's window,
# not this one, so a scout's context would otherwise land in the user's budget.
# And the docs say the transcript is written asynchronously, so the last record
# can lag by a turn — which is why what this returns is described everywhere as
# "the last completed turn" rather than "now".
#
# One tail and one jq, ~9ms on a real transcript. `fromjson?` is what makes the
# tail safe: the first line it lands in is usually cut mid-record, and a line
# that does not parse is simply dropped rather than failing the read.
context_tokens() {
  local path="${1:-}" n=""
  [ -n "$path" ] && [ -f "$path" ] && have jq || return 0
  n=$(tail -c "$MAX_TRANSCRIPT_TAIL" "$path" 2>/dev/null | jq -Rr '
    fromjson?
    | select(.type == "assistant" and (.isSidechain | not))
    | .message.usage
    | select(type == "object")
    | ((.input_tokens // 0) + (.cache_creation_input_tokens // 0)
       + (.cache_read_input_tokens // 0) + (.output_tokens // 0))
    | floor
  ' 2>/dev/null | tail -1)
  case "$n" in '' | *[!0-9]*) return 0 ;; esac
  printf '%s' "$n"
}

FLUX_TMPFILE=""
session_cleanup() {
  [ -n "$FLUX_TMPFILE" ] && rm -f "$FLUX_TMPFILE" 2>/dev/null
  return 0
}

# session_stamp <root> <key> <value>… — merge fields into .flux/session.json.
#
# Keys must come from SESSION_KEYS. A field the caller does not name keeps the
# value already on disk — `last_synced_commit` above all, which only /sync
# advances. A field the caller does name with an empty value is written as null:
# that is how a caller says "nothing is claimed" rather than "leave the claim
# alone".
#
# With jq, fields outside SESSION_KEYS survive the merge too, so a skill's own
# `status` (README) outlives the next heartbeat. The exception is a `status` left
# over from a different claim: once claimed_ticket changes, a stale status would
# relabel the wrong ticket, so it is dropped with the claim it described.
#
# Non-fatal by contract (ADR-0001): an unwritable .flux/, a full disk, a corrupt
# session.json — every one of them returns quietly and leaves the caller free to
# print its own output and exit 0. The write is atomic: temp file in .flux/, mv.
session_stamp() {
  local root="$1"
  shift
  local file="$root/.flux/session.json"
  local -a keys=() vals=()
  while [ "$#" -ge 2 ]; do
    keys+=("$1")
    vals+=("$2")
    shift 2
  done
  [ "${#keys[@]}" -gt 0 ] || return 0

  local k v i named body="" sep="" prev_claim new_claim="" keep=false
  prev_claim=$(session_field "$file" claimed_ticket)

  for k in "${SESSION_KEYS[@]}"; do
    v=""
    named=0
    for i in "${!keys[@]}"; do
      if [ "${keys[$i]}" = "$k" ]; then
        named=1
        v="${vals[$i]}"
      fi
    done
    [ "$named" -eq 1 ] || v=$(session_field "$file" "$k")
    if [ "${SESSION_NUMERIC#*" $k "}" != "$SESSION_NUMERIC" ]; then
      case "$v" in '' | *[!0-9]*) v=0 ;; esac
      body="$body$sep  \"$k\": $v"
    elif [ "${SESSION_NULLABLE_NUMERIC#*" $k "}" != "$SESSION_NULLABLE_NUMERIC" ]; then
      case "$v" in '' | *[!0-9]*) v=null ;; esac
      body="$body$sep  \"$k\": $v"
    else
      [ "$k" = claimed_ticket ] && new_claim="$v"
      body="$body$sep  \"$k\": $(json_or_null "$v")"
    fi
    sep=$',\n'
  done
  body=$'{\n'"$body"$'\n}'

  local merged=""
  if have jq && [ -s "$file" ]; then
    [ "$prev_claim" = "$new_claim" ] && keep=true
    merged=$(jq -n --slurpfile old "$file" --argjson new "$body" --argjson keep "$keep" \
      --argjson retired "$SESSION_RETIRED_KEYS" '
      (($old[0] // {}) + $new)
      | delpaths($retired | map([.]))
      | if $keep then . else del(.status) end
    ' 2>/dev/null)
  fi
  [ -n "$merged" ] || merged="$body"

  mkdir -p "$root/.flux" 2>/dev/null || return 0
  trap session_cleanup EXIT
  FLUX_TMPFILE=$(mktemp "$root/.flux/session.json.XXXXXX" 2>/dev/null) || {
    FLUX_TMPFILE=""
    return 0
  }
  if printf '%s\n' "$merged" >"$FLUX_TMPFILE" 2>/dev/null &&
    mv -f "$FLUX_TMPFILE" "$file" 2>/dev/null; then
    FLUX_TMPFILE=""
  else
    session_cleanup
    FLUX_TMPFILE=""
  fi
  return 0
}

# ------------------------------------------------------- markdown fallback ---

# Emit one TSV row per ticket file: id \t status \t agent \t blockers \t title.
# Files are globbed in name order, so rows arrive lowest-numbered first.
md_rows() {
  local root="$1"
  local -a files=()
  shopt -s nullglob
  files=("$root"/specs/*/tickets/*.md)
  shopt -u nullglob
  [ "${#files[@]}" -gt 0 ] || return 0

  awk '
    FNR == 1 { fm = 0; closed = 0; id = ""; st = ""; ag = ""; bl = ""; ti = "" }
    FNR == 1 && /^---[[:space:]]*$/ { fm = 1; next }
    closed { next }
    fm && /^---[[:space:]]*$/ {
      closed = 1
      if (id != "") printf "%s\t%s\t%s\t%s\t%s\n", id, st, ag, bl, ti
      next
    }
    fm {
      k = $0; sub(/:.*$/, "", k); gsub(/[[:space:]]/, "", k)
      v = $0; sub(/^[^:]*:[[:space:]]*/, "", v); sub(/[[:space:]]+$/, "", v)
      if (k == "id") id = v
      else if (k == "status") st = v
      else if (k == "agent") ag = v
      else if (k == "blockers") bl = v
      else if (k == "title") ti = v
    }
  ' "${files[@]}" 2>/dev/null
}

md_claimed() {
  md_rows "$1" | awk -F'\t' '$2 == "claimed" || $2 == "in_progress" { print $1 "\t" $5 }'
}

md_done() {
  md_rows "$1" | awk -F'\t' '$2 == "done" || $2 == "closed" { print $1 "\t" $5 }'
}

# Open tickets whose blockers are all done. Buffers rows so blockers can be
# resolved against tickets declared later in the file order.
md_ready() {
  md_rows "$1" | awk -F'\t' '
    { row[NR] = $0; status[$1] = $2 }
    END {
      for (i = 1; i <= NR; i++) {
        n = split(row[i], f, "\t")
        if (n < 5 || f[2] != "open") continue
        bl = f[4]; gsub(/[][[:space:]]/, "", bl)
        ok = 1
        if (bl != "") {
          m = split(bl, dep, ",")
          for (j = 1; j <= m; j++)
            if (dep[j] != "" && status[dep[j]] != "done") ok = 0
        }
        if (ok) print f[1] "\t" f[3] "\t" f[5]
      }
    }
  '
}

# ------------------------------------------------------------ store verbs ---
# The only beads reads the hooks perform. Both are read-only and must never
# trigger a sync. Output shape is fixed here so callers never see bd's schema.

# id \t title
store_claimed() {
  local root="$1" wt="$2" out=""
  if have "$BD_BIN" && have jq; then
    out=$("$BD_BIN" list --status in_progress --json 2>/dev/null |
      jq -r --arg wt "$wt" '
        (if type == "array" then . elif type == "object" then (.issues // .ready // []) else [] end)
        | map(select((.assignee // "") == "" or (.assignee // "") == $wt))
        | .[] | [.id, (.title // "")] | @tsv
      ' 2>/dev/null)
    [ -n "$out" ] && { printf '%s\n' "$out"; return 0; }
  fi
  md_claimed "$root"
}

# id \t title of the most recently completed ticket; empty when there is none.
#
# Recency is the whole difficulty. The markdown store has no timestamps and its
# ticket numbers are not a completion order — this repo finished FLX-19 after
# FLX-13 — so recency comes from git: the newest commit message naming a ticket
# that is done, which is exactly the convention that closes a ticket here. Beads
# has real close times and uses them instead. Outside a repo, or when nothing in
# recent history names a done ticket, it degrades to file order, which is at
# least stable.
store_done() {
  local root="$1" out="" rows="" hit="" id="" msg="" re=""
  if have "$BD_BIN" && have jq; then
    out=$("$BD_BIN" list --status closed --json 2>/dev/null |
      jq -r '
        (if type == "array" then . elif type == "object" then (.issues // .closed // []) else [] end)
        | sort_by(.closed_at // .updated_at // .created_at // "")
        | last // empty
        | [.id, (.title // "")] | @tsv
      ' 2>/dev/null)
    [ -n "$out" ] && { printf '%s\n' "$out"; return 0; }
  fi

  rows=$(md_done "$root")
  [ -n "$rows" ] || return 0
  re=$(ticket_id_re "$root")
  while IFS= read -r msg; do
    [[ $msg =~ ($re) ]] || continue
    id="${BASH_REMATCH[1]}"
    hit=$(printf '%s\n' "$rows" | awk -F'\t' -v want="$id" '$1 == want { print; exit }')
    [ -n "$hit" ] && { printf '%s\n' "$hit"; return 0; }
  done < <(git -C "$root" log -n "$MAX_DONE_SCAN" --format='%s' 2>/dev/null)
  printf '%s\n' "$rows" | tail -1
}

# id \t tier \t title
store_ready() {
  local root="$1" out=""
  if have "$BD_BIN" && have jq; then
    out=$("$BD_BIN" ready --json 2>/dev/null |
      jq -r '
        (if type == "array" then . elif type == "object" then (.ready // .issues // []) else [] end)
        | .[]
        | [ .id,
            (((.labels // []) | map(select(. == "chore" or . == "build" or . == "deep")))[0] // ""),
            (.title // "") ]
        | @tsv
      ' 2>/dev/null)
    [ -n "$out" ] && { printf '%s\n' "$out"; return 0; }
  fi
  md_ready "$root"
}
