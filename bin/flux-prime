#!/usr/bin/env bash
#
# flux-prime — SessionStart hook: inject the "where am I" block into a session.
#
# Contract (ADR-0001, fail-open): no network, under 500ms, and always exit 0 — a
# broken prime degrades to plain Claude Code, never blocks it. The ticket store
# is reached only through the store_* verbs (ADR-0002).
#
# Read-only except for one stamp: the claim and the last completion it just
# resolved go into .flux/session.json before it prints (ADR-0005), because the
# statusline renders from that file and no heartbeat has run yet in a new session.
# Non-fatal — a failed stamp still leaves the block printed and the exit 0.
#
# stdin:  SessionStart hook JSON — {session_id, transcript_path, cwd, hook_event_name, source}
# stdout: plain text, injected verbatim as context. Empty when nothing is known.
#
# The store verbs and the markdown fallback live in bin/flux-common, shared with
# flux-heartbeat. Env: FLUX_BD — see flux-common.

set -u

# shellcheck source=/dev/null
. "$(dirname "${BASH_SOURCE[0]}")/flux-common" 2>/dev/null || exit 0

MAX_FRONTIER=5
MAX_HANDOFFS=5
TITLE_WIDTH=72

# ---------------------------------------------------------------- helpers ---

# Trim to TITLE_WIDTH, appending an ellipsis when cut.
clip() {
  local s="$1"
  if [ "${#s}" -gt "$TITLE_WIDTH" ]; then
    printf '%s…' "${s:0:$((TITLE_WIDTH - 1))}"
  else
    printf '%s' "$s"
  fi
}

# ------------------------------------------------------------- collectors ---

# Handoffs are residue files in .flux/handoffs/. Presence means unconsumed —
# whoever consumes one removes it. Emits: filename \t first meaningful line.
collect_handoffs() {
  local root="$1" f line
  local -a files=()
  shopt -s nullglob
  files=("$root"/.flux/handoffs/*.md)
  shopt -u nullglob
  for f in "${files[@]}"; do
    line=$(awk '
      NR == 1 && /^---[[:space:]]*$/ { fm = 1; next }
      fm && /^---[[:space:]]*$/ { fm = 0; next }
      fm { next }
      /^[[:space:]]*$/ { next }
      { sub(/^#+[[:space:]]*/, ""); sub(/[[:space:]]+$/, ""); print; exit }
    ' "$f" 2>/dev/null)
    printf '%s\t%s\n' "$(basename "$f")" "$line"
  done
}

# ------------------------------------------------------------------- main ---

main() {
  local stdin_json cwd root worktree
  stdin_json=$(cat 2>/dev/null)

  cwd=$(hook_cwd "$stdin_json")
  root=$(repo_root "$cwd")
  worktree=$(basename "$root")

  local claimed ready handoffs drift last_done
  claimed=$(store_claimed "$root" "$worktree" 2>/dev/null)
  ready=$(store_ready "$root" 2>/dev/null)
  last_done=$(store_done "$root" 2>/dev/null)
  handoffs=$(collect_handoffs "$root" 2>/dev/null)
  drift=$(drift_count "$root" 2>/dev/null)
  case "$drift" in '' | 0 | *[!0-9]*) drift=0 ;; esac

  local known="$claimed$ready$handoffs"
  [ "$drift" -gt 0 ] && known="$known$drift"

  # Stamped after the collectors, before the print: drift is counted from the
  # baseline in this same file, and only /sync may move that. Skipped entirely
  # in a repo flux knows nothing about — starting a session there is no reason
  # to create a .flux/ in it.
  if [ -n "$known" ] || [ -d "$root/.flux" ]; then
    session_stamp "$root" \
      claimed_ticket "$(first_id "$claimed")" \
      last_done_ticket "$(first_id "$last_done")" \
      drift_commits "$drift"
  fi

  [ -n "$known" ] || return 0

  printf 'flux · %s\n' "$worktree"

  local row id tier title rest n shown
  if [ -n "$claimed" ]; then
    while IFS= read -r row; do
      split_row "$row" id title
      [ -n "$id" ] || continue
      printf 'Claimed: %s %s\n' "$id" "$(clip "$title")"
    done <<<"$claimed"
  fi

  if [ -n "$ready" ]; then
    n=$(printf '%s\n' "$ready" | grep -c '' 2>/dev/null || echo 0)
    printf 'Frontier (%s ready):\n' "$n"
    shown=0
    while IFS= read -r row; do
      split_row "$row" id tier title
      [ -n "$id" ] || continue
      shown=$((shown + 1))
      [ "$shown" -le "$MAX_FRONTIER" ] || break
      if [ -n "$tier" ]; then
        printf '  %s [%s] %s\n' "$id" "$tier" "$(clip "$title")"
      else
        printf '  %s %s\n' "$id" "$(clip "$title")"
      fi
    done <<<"$ready"
    rest=$((n - MAX_FRONTIER))
    [ "$rest" -gt 0 ] && printf '  (+%s more)\n' "$rest"
  fi

  if [ -n "$handoffs" ]; then
    n=$(printf '%s\n' "$handoffs" | grep -c '' 2>/dev/null || echo 0)
    printf 'Handoffs (%s unconsumed):\n' "$n"
    shown=0
    while IFS= read -r row; do
      split_row "$row" id title
      [ -n "$id" ] || continue
      shown=$((shown + 1))
      [ "$shown" -le "$MAX_HANDOFFS" ] || break
      if [ -n "$title" ]; then
        printf '  %s — %s\n' "$id" "$(clip "$title")"
      else
        printf '  %s\n' "$id"
      fi
    done <<<"$handoffs"
    rest=$((n - MAX_HANDOFFS))
    [ "$rest" -gt 0 ] && printf '  (+%s more)\n' "$rest"
  fi

  # Both endings, always. A line that only ever says "run /sync" describes one
  # legal outcome out of two: work committed outside the harness on purpose is
  # not a defect, and the user who says so is answering the question, not
  # refusing it. Naming the decline is also what keeps it from being asked
  # again — /sync --skip advances the baseline past these commits, so the count
  # a declined drift leaves behind is zero rather than the same number tomorrow.
  if [ "$drift" -eq 1 ]; then
    printf '1 commit not linked to tickets — run /sync when convenient, or /sync --skip to accept it as it is.\n'
  elif [ "$drift" -gt 1 ]; then
    printf '%s commits not linked to tickets — run /sync when convenient, or /sync --skip to accept them as they are.\n' "$drift"
  fi

  # None of the above is on the user's screen: SessionStart output goes to the
  # model's context and is never rendered (ADR-0007). The status line carries
  # standing state, but a handoff has nowhere else to surface, so the block asks
  # for its own relay. One line — the block is for orientation first, and Claude
  # Code produces no turn until the user types, so this rides on the first
  # answer rather than greeting an empty screen.
  printf 'The user cannot see this block — lead your first reply with one line of it: claim, drift, handoffs.\n'

  return 0
}

main 2>/dev/null
exit 0
